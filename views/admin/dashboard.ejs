<%- include("../../views/admin/partials/header") %>
<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title card-title">Dashboard </h2>
        </div>
        <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#shippingTaxModal">
  <i class="bi bi-gear"></i> Shipping & Tax Settings
</button>
   
    </div>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin/dashboard.css" type="text/css">
</head>
<body>
    <div class="page-header">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <h1 class="mb-1"><i class="bi bi-graph-up-arrow me-2"></i>Sales Report</h1>
          <p class="mb-0 opacity-75">Analyze your sales performance and generate reports</p>
        </div>
      </div>
    </div>
  </div>
  <div class="card shadow-sm mb-4">
  <div class="card-header d-flex justify-content-between align-items-center bg-white">
    <h6 class="mb-0 fw-bold">Sales Overview</h6>
    <div class="btn-group btn-group-sm" id="chartFilterGroup">
      <button class="btn btn-outline-primary active" onclick="loadChart('yearly')">Yearly</button>
      <button class="btn btn-outline-primary" onclick="loadChart('monthly')">Monthly</button>
      <button class="btn btn-outline-primary" onclick="loadChart('weekly')">Weekly</button>
      <button class="btn btn-outline-primary" onclick="loadChart('daily')">Daily</button>
    </div>
  </div>
  <div class="card-body">
    <canvas id="salesChart" height="100"></canvas>
  </div>
</div>
<div class="row g-3 mb-4">
  <!-- Best Selling Products -->
  <div class="col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white"><h6 class="mb-0 fw-bold">Top 10 Products</h6></div>
      <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr><th>#</th><th>Product</th><th class="text-end">Sold</th></tr>
          </thead>
          <tbody id="topProductsBody">
            <tr><td colspan="3" class="text-center text-muted py-3">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Best Selling Categories -->
  <div class="col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white"><h6 class="mb-0 fw-bold">Top 10 Categories</h6></div>
      <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr><th>#</th><th>Category</th><th class="text-end">Sold</th></tr>
          </thead>
          <tbody id="topCategoriesBody">
            <tr><td colspan="3" class="text-center text-muted py-3">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Best Selling Brands -->
  <div class="col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white"><h6 class="mb-0 fw-bold">Top 10 Brands</h6></div>
      <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr><th>#</th><th>Brand</th><th class="text-end">Sold</th></tr>
          </thead>
          <tbody id="topBrandsBody">
            <tr><td colspan="3" class="text-center text-muted py-3">Loading...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
  <!-- Loading Overlay -->
  <div class="loading-overlay" id="loadingOverlay">
    <div class="spinner-border text-primary" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
  </div>
  <!-- Page Header -->
  <div class="container pb-5">
    <!-- Filter Section -->
    <div class="card mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-funnel me-2"></i>Report Filters</span>
        <button class="btn btn-sm btn-outline-secondary" onclick="resetFilters()">
          <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
        </button>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <!-- Quick Filter Buttons -->
          <div class="col-12">
            <label class="form-label fw-semibold">Quick Select Period</label>
            <div class="d-flex flex-wrap gap-2">
              <button class="filter-btn" data-period="today" onclick="selectPeriod('today')">
                <i class="bi bi-calendar-day me-1"></i>Today
              </button>
              <button class="filter-btn" data-period="yesterday" onclick="selectPeriod('yesterday')">
                <i class="bi bi-calendar-minus me-1"></i>Yesterday
              </button>
              <button class="filter-btn" data-period="week" onclick="selectPeriod('week')">
                <i class="bi bi-calendar-week me-1"></i>This Week
              </button>
              <button class="filter-btn" data-period="month" onclick="selectPeriod('month')">
                <i class="bi bi-calendar-month me-1"></i>This Month
              </button>
              <button class="filter-btn" data-period="year" onclick="selectPeriod('year')">
                <i class="bi bi-calendar me-1"></i>This Year
              </button>
              <button class="filter-btn" data-period="custom" onclick="selectPeriod('custom')">
                <i class="bi bi-calendar-range me-1"></i>Custom Range
              </button>
            </div>
          </div>
          <!-- Custom Date Range -->
          <div class="col-12 custom-date-section" id="customDateSection">
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label fw-semibold">Start Date</label>
                <input type="date" class="form-control" id="startDate">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">End Date</label>
                <input type="date" class="form-control" id="endDate">
              </div>
              <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-primary w-100" onclick="applyCustomDate()">
                  <i class="bi bi-check-lg me-1"></i>Apply Date Range
                </button>
              </div>
            </div>
          </div>
          <!-- Generate Report Button -->
          <div class="col-12">
            <hr class="my-3">
            <button class="btn btn-primary btn-lg" onclick="generateReport()">
              <i class="bi bi-file-earmark-bar-graph me-2"></i>Generate Report
            </button>
          </div>
        </div>
      </div>
    </div>
    <!-- Stats Cards -->
    <div class="row g-4 mb-4" id="statsSection" style="display: none;">
      <div class="col-md-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="stat-label mb-1">Total Sales Count</p>
              <p class="stat-value mb-0" id="totalSalesCount">0</p>
            </div>
            <div class="stat-icon sales">
              <i class="bi bi-cart-check"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="stat-label mb-1">Total Order Amount</p>
              <p class="stat-value mb-0">₹<span id="totalOrderAmount">0</span></p>
            </div>
            <div class="stat-icon orders">
              <i class="bi bi-currency-rupee"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="stat-label mb-1">Total Refunds</p>
              <p class="stat-value mb-0 text-warning">₹<span id="totalDiscount">0</span></p>
            </div>
            <div class="stat-icon discount">
              <i class="bi bi-arrow-counterclockwise"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <p class="stat-label mb-1">Coupon Deductions</p>
              <p class="stat-value mb-0 text-danger">₹<span id="totalCouponDeduction">0</span></p>
            </div>
            <div class="stat-icon coupon">
              <i class="bi bi-ticket-perforated"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Report Table & Download Section -->
    <div class="card" id="reportSection" style="display: none;">
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span><i class="bi bi-table me-2"></i>Sales Report Details</span>
        <div class="d-flex gap-2">
          <button class="btn btn-danger download-btn" onclick="downloadReport('pdf')">
            <i class="bi bi-file-earmark-pdf"></i>Download PDF
          </button>
        </div>
      </div>
      <div class="card-body">
        <!-- Report Summary Info -->
        <div class="alert alert-info d-flex align-items-center mb-4" id="reportInfo">
          <i class="bi bi-info-circle me-2"></i>
          <span id="reportPeriodText">Report Period: --</span>
        </div>
        <!-- Report Table -->
        <div class="report-table-container">
          <table class="table table-hover" id="reportTable">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Items</th>
                <th>Subtotal</th>
                <th>Discount</th>
                <th>Coupon</th>
                <th>Final Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="reportTableBody">
              <!-- Data will be populated here -->
            </tbody>
            <tfoot class="table-light">
              <tr class="fw-bold">
                <td colspan="4">Grand Total</td>
                <td id="footerSubtotal">₹0</td>
                <td id="footerDiscount" class="text-warning">₹0</td>
                <td id="footerCoupon" class="text-danger">₹0</td>
                <td id="footerTotal" class="text-success">₹0</td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <!-- Empty State -->
        <div class="empty-state" id="emptyState" style="display: none;">
          <i class="bi bi-inbox"></i>
          <h5>No Data Found</h5>
          <p>No sales data available for the selected period.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="shippingTaxModal" tabindex="-1" aria-labelledby="shippingTaxModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="shippingTaxModalLabel">Shipping & Tax Settings</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label for="shippingRate" class="form-label fw-semibold">Shipping Rate (₹)</label>
          <input type="number" class="form-control" id="shippingRate" value="<%=shipping%>" min="0" step="0.01" placeholder="Enter shipping rate">
        </div>
        <div class="mb-3">
          <label for="taxRate" class="form-label fw-semibold">Tax Rate (%)</label>
          <input type="number" class="form-control" id="taxRate" value="<%=taxes%>" min="0" max="100" step="0.01" placeholder="Enter tax percentage">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveShippingTax()">Submit</button>
      </div>
    </div>
  </div>
</div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script src="/js/admin/dashboard.js"></script>
</section>
<%- include("../../views/admin/partials/footer") %>