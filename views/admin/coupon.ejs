<%- include("../../views/admin/partials/header") %>
  <title>Coupon Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/admin/coupon.css" type="text/css">
  
  <div class="container mt-5 pb-2">
    <!-- Stats Row -->
    <div class="row g-4 mb-4">
      <div class="col-md-3">
        <div class="stats-card">
          <div class="icon" style="background: rgba(79, 70, 229, 0.1); color: var(--primary);">
            <i class="bi bi-ticket"></i>
          </div>
          <h3><%=totalCoupons%></h3>
          <p>Total Coupons</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stats-card">
          <div class="icon" style="background: rgba(16, 185, 129, 0.1); color: var(--success);">
            <i class="bi bi-check-circle"></i>
          </div>
          <h3><%=activeCoupons%></h3>
          <p>Active Coupons</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stats-card">
          <div class="icon" style="background: rgba(245, 158, 11, 0.1); color: var(--warning);">
            <i class="bi bi-graph-up"></i>
          </div>
          <h3><%=totalRedemptions%></h3>
          <p>Total Redemptions</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stats-card">
          <div class="icon" style="background: rgba(239, 68, 68, 0.1); color: var(--danger);">
            <i class="bi bi-currency-rupee"></i>
          </div>
          <h3>₹0</h3>
          <p>Discount Given</p>
        </div>
      </div>
    </div>

    <!-- Coupons Table -->
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-list-ul me-2 text-primary"></i>All Coupons</h5>
        <div class="d-flex gap-2">
          <button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#couponModal" onclick="openAddModal()">
            <i class="bi bi-plus-lg me-2"></i>Add Coupon
          </button>
          <input type="text" id="search" value="<%= search %>" class="form-control form-control-sm" placeholder="Search coupons..." style="width: 200px;">
          <select class="form-select form-select-sm" id="status" style="width: 140px;">
            <option value="">All Status</option>
            <option value="Active" <%=filter.status=="Active"?"selected":""%>>Active</option>
            <option value="Expired" <%=filter.status=="Expired"?"selected":""%>>Expired</option>
            <option value="Scheduled" <%=filter.status=="Scheduled"?"selected":""%>>Scheduled</option>
          </select>
          <button class="btn btn-primary btn-sm" onclick="applyFilters()">Submit</button>
          <button class="btn btn-danger btn-sm" onclick="clearFilters()">Clear</button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table" id="couponsTable">
          <thead>
            <tr>
              <th>Code</th>
              <th>Discount</th>
              <th>Type</th>
              <th>Min. Purchase</th>
              <th>Usage</th>
              <th>Validity</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="body">
            <% coupon.forEach((item)=>{%>
            <tr id="couponRow<%=item.code%>">
              <td><span class="coupon-code"><%=item.code%></span></td>
              <td><span class="discount-value"><%=item.discountValue%></span></td>
              <td><%=item.discountType%></td>
              <td>₹<%=item.minPurchase%></td>
              <td>
                <span><%=item.redemptions%> / <%=item.usageLimit%></span>
                <div class="usage-bar"><div class="usage-bar-fill" style="width: 45%;"></div></div>
              </td>
              <td>
                <small class="text-muted"><%=item.startDate.toLocaleString("en-IN",{day:"numeric",month:"long",year:"numeric"})%>-<%=item.expiryDate.toLocaleString("en-IN",{day:"numeric",month:"long",year:"numeric"})%></small>
              </td>
              <% if(item.status==="Active") {%>
                <td><span class="badge-status badge-active"><%=item.status%></span></td>
              <%}else if(item.status==="Scheduled"){%>
                <td><span class="badge-status badge-scheduled"><%=item.status%></span></td>
              <%}else{%>
                <td><span class="badge-status badge-expired"><%=item.status%></span></td> 
                <% } %>
              <td>
                <div class="d-flex gap-2">
                  <button class="btn btn-action btn-edit" onclick="openEditModal('<%=item.code%>', '<%=item.discountValue%>', '<%=item.discountType%>','<%=item.minPurchase%>', '<%=item.maxDiscount%>', '<%=item.usageLimit%>','<%=item.startDate%>' ,'<%=item.expiryDate%>')">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <button class="btn btn-action btn-delete" onclick="deleteCoupon('<%=item.code%>')">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </td>
            </tr>
           <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="d-flex flex-column justify-content-between align-items-center mt-0">
  <nav>
    <ul class="pagination pagination-sm mb-0">

      <!-- Previous button -->
      <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
        <a class="page-link" <%=currentPage==1?"Disabled":""%>href="?page=<%= parseInt(currentPage)-1 %>">Previous</a>
      </li>

      <!-- Page numbers -->
      <% for(let i=1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
        </li>
      <% } %>

      <!-- Next button -->
      <li class="page-item <%= currentPage == totalPages ? 'disabled' : '' %>">
        <a class="page-link"<%=currentPage==totalPages?"Disabled":""%> href="?page=<%= parseInt(currentPage)+1 %>">Next</a>
      </li>

    </ul>
  </nav>
  <div class="text-muted small">
    Showing <%= (currentPage-1)*limit + 1 %> to 
            <%= Math.min(currentPage*limit, totalCoupons) %> of <%= totalCoupons %> coupons
  </div>

  <!-- Add/Edit Coupon Modal -->
  <div class="modal fade" id="couponModal" tabindex="-1" aria-labelledby="couponModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="couponModalLabel">
            <i class="bi bi-plus-circle me-2 text-primary"></i>Add New Coupon
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="couponForm">
          <div class="modal-body">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Coupon Code</label>
                <input type="text" class="form-control" id="couponCode" placeholder="e.g., SAVE20" required style="text-transform: uppercase;">
              </div>
              <div class="col-md-6">
                <label class="form-label">Discount Type</label>
                <select class="form-select" id="discountType" required>
                  <option value="percentage">Percentage (%)</option>
                  <option value="fixed">Fixed Amount (₹)</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Discount Value</label>
                <input type="number" class="form-control" id="discountValue" placeholder="Enter value" required min="1">
              </div>
              <div class="col-md-6">
                <label class="form-label">Minimum Purchase (₹)</label>
                <input type="number" class="form-control" id="minPurchase" placeholder="0 for no minimum" value="0" min="0">
              </div>
              <div class="col-md-6">
                <label class="form-label">Usage Limit</label>
                <input type="number" class="form-control" id="usageLimit" placeholder="0 for unlimited" value="0" min="0">
              </div>
              <div class="col-md-6">
                <label class="form-label">Max Discount (₹)</label>
                <input type="number" class="form-control" id="maxDiscount" placeholder="For percentage type" min="0">
              </div>
              <div class="col-md-6">
                <label class="form-label">Start Date</label>
                <input type="date" class="form-control" id="startDate">
              </div>
              <div class="col-md-6">
                <label class="form-label">End Date</label>
                <input type="date" class="form-control" id="endDate">
              </div>
              <div class="col-12">
                <label class="form-label">Description (Optional)</label>
                <textarea class="form-control" id="description" rows="2" placeholder="Brief description of the coupon..."></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary" id="submitBtn">
              <i class="bi bi-check-lg me-2"></i>Save Coupon
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/admin/coupon.js"></script>
<%- include("../../views/admin/partials/footer") %>

