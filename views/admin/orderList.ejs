<%- include("../../views/admin/partials/header") %> 
  <style>
    body {
      background-color: #f8f9fa;
      font-size: 0.9rem;
    }
    .card {
      border-radius: 8px;
      border: none;
    }
    .card-body {
      padding: 1.25rem;
    }
    .table {
      font-size: 0.875rem;
      margin-bottom: 0;
    }
    .table thead th {
      background-color: #f8f9fa;
      border-bottom: 2px solid #dee2e6;
      font-weight: 600;
      padding: 0.75rem 0.5rem;
    }
    .table tbody td {
      padding: 0.75rem 0.5rem;
      vertical-align: middle;
    }
    .badge {
      padding: 0.35em 0.65em;
      font-size: 0.75rem;
      font-weight: 500;
    }
    .btn-sm {
      padding: 0.25rem 0.75rem;
      font-size: 0.8rem;
    }
    .form-control, .form-select {
      font-size: 0.875rem;
      padding: 0.5rem 0.75rem;
    }
    .search-filters {
      background-color: white;
      border-radius: 8px;
      padding: 1rem;
      margin-bottom: 1rem;
    }
    .status-pending { background-color: #ffc107; color: #000; }
    .status-shipped { background-color: #17a2b8; }
    .status-out-for-delivery { background-color: #fd7e14; }
    .status-delivered { background-color: #28a745; }
    .status-cancelled { background-color: #dc3545; }
    .pagination {
      margin-bottom: 0;
    }
    .order-id {
      font-family: monospace;
      font-size: 0.85rem;
      color: #495057;
    }

    .hideReturnHandlers{
      display: none;
    }
  </style>
<body>
  <div class="container-fluid py-3 px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="mb-0 fw-bold">Order Management</h4>
    </div>

    <!-- Search & Filters -->
    <div class="search-filters">
      <div class="row g-2">
        <div class="col-md-3">
          <input type="text" value="<%=queryValues.search%>" class="form-control" id="searchInput" placeholder="Search Order ID, User...">
        </div>
        <div class="col-md-2">
          <select class="form-select" id="statusFilter">
            <option value="">All Status</option>
            <option value="Pending"<%=queryValues.status=="Pending"?"selected":""%>>Pending</option>
            <option value="Shipped"<%=queryValues.status=="Shipped"?"selected":""%>>Shipped</option>
            <option value="Out for delivery"<%=queryValues.status=="Out for delivery"?"selected":""%>>Out for Delivery</option>
            <option value="Delivered"<%=queryValues.status=="Delivered"?"selected":""%>>Delivered</option>
            <option value="Cancelled"<%=queryValues.status=="Cancelled"?"selected":""%>>Cancelled</option>
            <option value="Processing return"<%=queryValues.status=="Processing return"?"selected":""%>>Processing return</option>
            <option value="Returned"<%=queryValues.status=="Returned"?"selected":""%>>Returned</option>
            <option value="Return rejected"<%=queryValues.status=="Return rejected"?"selected":""%>>Return rejected</option>
          </select>
        </div>
        <div class="col-md-2">
          <select class="form-select" id="sortBy">
            <option value="date-desc"<%=queryValues.sort=="date-desc"?"selected":""%>>Date (Newest)</option>
            <option value="date-asc"<%=queryValues.sort=="date-asc"?"selected":""%>>Date (Oldest)</option>
            <option value="amount-desc"<%=queryValues.sort=="amount-desc"?"selected":""%>>Amount (High-Low)</option>
            <option value="amount-asc"<%=queryValues.sort=="amount-asc"?"selected":""%>>Amount (Low-High)</option>
          </select>
        </div>
        <div class="col-md-2">
          <input type="date" value="<%=queryValues.date%>" class="form-control" id="dateFilter">
        </div>
        <div class="col-md-3 text-end">
          <button class="btn btn-sm btn-outline-secondary" id="clearFilters">
            <i class="bi bi-x-circle"></i> Clear Filters
          </button>
          <button class="btn btn-sm btn-success"  id="applyFilters">
            <i class="bi bi-search"></i> Search
          </button>
        </div>
      </div>
    </div>

    <!-- Orders Table -->
    <div class="card shadow-sm">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Items</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Return</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="ordersTableBody">
             <% orderDetails.forEach((order)=>{%>
              <tr>
                <td><span class="order-id"><%= order.orderId %></span></td>
                <td><%= order.createdAt.toDateString() %></td>
                <td>
                  <div class="fw-semibold"><%= order.name %></div>
                  <small class="text-muted"><%= order.email %></small>
                </td>
                <td><%= order.products.length%> items</td>
                <td class="fw-semibold">₹<%= order.totalAmount%></td>
                <td>
                  <select class="form-select form-select-sm status-dropdown" onchange="handleOrderStatus(this.value,'<%= order.orderId %>','<%=order.email%>')">
                    <option value="Pending" <%= order.status === "Pending" ? "selected" : "" %>>Pending</option>
                    <option value="Shipped"<%= order.status === "Shipped" ? "selected" : "" %>>Shipped</option>
                    <option value="Out for delivery" <%= order.status === "Out for delivery" ? "selected" : "" %>>Out for Delivery</option>
                    <option value="Delivered" <%= order.status === "Delivered" ? "selected" : "" %>>Delivered</option>
                    <option value="Processing return" <%= order.status === "Processing return" ? "selected" : "" %>>Processing return</option>
                    <option value="Return rejected" <%= order.status === "Return rejected" ? "selected" : "" %>>Return rejected</option>
                    <option value="Cancelled" <%= order.status === "Cancelled" ? "selected" : "" %>>Cancelled</option>
                    <option value="Returned" <%= order.status === "Returned" ? "selected" : "" %>>Returned</option>
                  </select>
                </td>
                <td>
                  <% if(order.status=="Return rejected") {%>
                       <span class="badge bg-warning text-dark returnRequestStat" >Rejected</span>
                    <% }else if(order.status=="Returned"){ %>
                      <span class="badge bg-warning text-dark returnRequestStat" >Approved</span>
                      <% }else{%>
                  <span class="badge bg-warning text-dark returnRequestStat" ><%= order.status==="Processing return"? "Requested" : "Not requested" %></span>
                  <% } %>
                  <button class="btn btn-sm btn-outline-success mt-1 returHandleButton"  onclick="handleReturnVerification('<%=order.orderId%>','<%=order.email%>', true)">
                    <i class="bi bi-check-circle"></i> Approve
                  </button>
                  <button class="btn btn-sm btn-outline-danger mt-1 returHandleButton"  onclick="handleReturnVerification('<%=order.orderId%>','<%=order.email%>', false)">
                    <i class="bi bi-x-circle"></i> Reject
                  </button>
                </td>
                <td>
                  <button class="btn btn-sm btn-outline-primary" onclick="viewOrderDetails('<%=order.orderId%>','<%=order.email%>')">
                    <i class="bi bi-eye"></i> View
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Pagination -->
 <div class="d-flex justify-content-between align-items-center mt-3">
  <div class="text-muted small">
    Showing <%= (currentPage-1)*limit + 1 %> to 
            <%= Math.min(currentPage*limit, totalOrders) %> of <%= totalOrders %> orders
  </div>
  <nav>
    <ul class="pagination pagination-sm mb-0">

      <!-- Previous button -->
      <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= currentPage-1 %>">Previous</a>
      </li>

      <!-- Page numbers -->
      <% for(let i=1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
          <a class="page-link" href="?page=<%= i %>"><%= i %></a>
        </li>
      <% } %>

      <!-- Next button -->
      <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="?page=<%= currentPage+1 %>">Next</a>
      </li>

    </ul>
  </nav>
</div>

  <!-- Return Verification Modal -->
  <div class="modal fade" id="returnModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Return Request Verification</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p>Are you sure you want to <strong id="returnAction"></strong> the return request for order <strong id="returnOrderId"></strong>?</p>
          <div id="approvalNote" style="display: none;">
            <div class="alert alert-info">
              <i class="bi bi-info-circle"></i> The refund amount will be credited to the customer's wallet.
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="confirmReturn">Confirm</button>
        </div>
      </div>
    </div>
  </div>

   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> 
  <script>
  
  document.addEventListener("DOMContentLoaded",returnStatHandling());
  function returnStatHandling() {
  document.querySelectorAll("tr").forEach(row => {
    const requestStatus = row.querySelector(".returnRequestStat")?.innerText.trim();
    const buttons = row.querySelectorAll(".returHandleButton");

    if (requestStatus !== "Requested") {
      buttons.forEach(btn => btn.classList.add("hideReturnHandlers"));
    } else {
      buttons.forEach(btn => btn.classList.remove("hideReturnHandlers"));
    }
  });
}




function handleOrderStatus(status,orderId,email){
     console.log("Status handler works");
     fetch(`/admin/change-order-status/${orderId}`,{
      method:"POST",
     headers:{
      "content-type":"application/json"
     },
      body:JSON.stringify({status,email}),
     }).then((res)=>res.json())
     .then((data)=>{
      if(data.success){
        alert("Order status changed successfully!")
        window.location.reload();
      }else{
        alert(`${data.message}`);
      }
     })
     .catch((err)=>{
      console.log(err);
      alert(`${err}`);
     })
}


    // Handle return verification
    let currentReturnOrder = null;
    let currentReturnApproval = false;

    function handleReturnVerification(orderId,email,approve) {
      currentReturnOrder = orderId;
      currentReturnApproval = approve;
      
      document.getElementById('returnOrderId').textContent = orderId;
      document.getElementById('returnAction').textContent = approve ? 'APPROVE' : 'REJECT';
      document.getElementById('approvalNote').style.display = approve ? 'block' : 'none';
      
      const modal = new bootstrap.Modal(document.getElementById('returnModal'));
      modal.show();
          document.getElementById('confirmReturn').addEventListener('click', function() {
      if (currentReturnApproval) {
        // Approve return - refund to wallet
        fetch(`/admin/handle-refund/${orderId}`,{
          method:"POST",
          headers:{
            "content-type":"application/json"
          },
          body:JSON.stringify({email,currentReturnApproval})
        }).then((res)=>res.json())
          .then((data)=>{
            if(data.success==true){
              console.log(`Approving return for ${currentReturnOrder} and refunding to wallet`);
              document.querySelector(".retrurnRequestStat").innerHTML="Approved"
              alert(`${data.message}`);
            }
          })
      } else {
        // Reject return
        fetch(`/admin/handle-refund/${orderId}`,{
          method:"POST",
          headers:{
            "content-type":"application/json"
          },
          body:JSON.stringify({email,currentReturnApproval})
        }).then((res)=>res.json())
        .then((data)=>{
          if(data.success=true){
              console.log(`Rejecting return for ${currentReturnOrder}`);
              document.querySelector(".retrurnRequestStat").innerHTML="Rejected"
              alert(`${data.message}`);
          }
        })
      }
      
      bootstrap.Modal.getInstance(document.getElementById('returnModal')).hide();
    });
    }

    // View order details
    function viewOrderDetails(orderId,email) {
      window.location.href = `/admin/orderDetails?orderId=${orderId}&email=${email}`;
    }

    // Search and filter functionality
    document.getElementById('applyFilters').addEventListener('click',(e)=>{
      let searchInput=document.getElementById("searchInput").value;
      let statusFilter=document.getElementById("statusFilter").value;
      let sortByDate=document.getElementById("sortBy").value;
      let dateFilter=document.getElementById("dateFilter").value;
      console.log(searchInput," ",statusFilter," ",sortByDate," ",dateFilter);
      window.location.href=`/admin/orderList?search=${searchInput}&status=${statusFilter}&sort=${sortByDate}&date=${dateFilter}`

    });

    document.getElementById('clearFilters').addEventListener('click', ()=> {
      
      window.location.href="/admin/orderList"

    });

    // Enter key for search
    document.getElementById('searchInput').addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        document.getElementById('applyFilters').click();
      }
    });
  </script>
</body>
<%- include("../../views/admin/partials/footer") %>  