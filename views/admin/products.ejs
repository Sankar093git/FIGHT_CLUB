<%- include("../../views/admin/partials/header") %>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/css/admin/product.css" type="text/css">

<section class="products-page">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <div class="page-title-icon">
                    <i class="fa fa-box"></i>
                </div>
                Products
            </h1>
        </div>

        <!-- Main Content Card -->
        <div class="content-card">
            <!-- Search Header -->
        <form action="" method="get">
            <div class="card-header-section">
                <div class="search-wrapper">
                    <i class="fa fa-search"></i>
                    <input type="text" value="<%=queryVal.prod%>" id="prod" class="search-input" placeholder="Search products..." name="prod">
                    <% if(queryVal.prod) {%>
                        <button class="clear-btn" onclick="clearFilters('product')">Clear</button>
                        <% }else{ %>
                    <button class="search-btn" type="submit">Search</button>
                    <% } %>
                </div>

                <div class="search-wrapper">
                    <i class="fa fa-search"></i>
                    <input type="text" value="<%=queryVal.cate%>" id="cate" class="search-input" placeholder="Search category..." name="cate">
                    <% if(queryVal.cate) {%>
                        <button class="clear-btn" onclick="clearFilters('category')">Clear</button>
                        <% }else{ %>
                    <button class="search-btn" type="submit">Search</button>
                    <% } %>
                </div>

                <div class="search-wrapper">
                    <i class="fa fa-search"></i>
                    <input type="text" value="<%=queryVal.brand%>" id="brand" class="search-input" placeholder="Search brands..." name="brand">
                    <% if(queryVal.brand) {%>
                        <button class="clear-btn" onclick="clearFilters('brand')">Clear</button>
                        <% }else{ %>
                    <button class="search-btn" type="submit">Search</button>
                    <% } %>
                </div>
            </div>
            </form>

            <!-- Products Table -->
            <table class="products-table">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Sale Price</th>
                        <th>Offer</th>
                        <th>Manage Offer</th>
                        <th>Quantity</th>
                        <th>Status</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(let i = 0; i < data.length; i++) { %>
                    <tr>
                        <td>
                            <span class="product-name"><%= data[i].productName %></span>
                        </td>
                         <td>
                            <span class="category-badge">
                                <i class="fa fa-tag"></i>
                                <%= data[i].category.name %>
                            </span>
                        </td>
                        <td>
                            <span id="priceTag<%= data[i]._id %>" class="price-tag">₹<%= data[i].salesPrice %></span>
                        </td>
                        <td>
                            <% if(data[i].offer > 0) { %>
                                <span id="offerBadge<%= data[i]._id %>" class="offer-badge">
                                    <%= data[i].offer %>
                                    <i class="fa fa-percent"></i>
                                </span>
                            <% } else { %>
                                <span id="offerBadge<%= data[i]._id %>" class="offer-badge no-offer">No Offer</span>
                            <% } %>
                        </td>
                        <td>
                            <% if(data[i].offer === 0) { %>
                                <button id="offerBtn<%= data[i]._id %>" class="btn-action btn-offer-add" onclick="addOffer('<%= data[i]._id %>')">
                                    <i class="fa fa-plus"></i> Add Offer
                                </button>
                            <% } else { %>
                                <button id="offerBtn<%= data[i]._id %>" class="btn-action btn-offer-remove" onclick="removeOffer('<%= data[i]._id %>')">
                                    <i class="fa fa-times"></i> Remove
                                </button>
                            <% } %>
                        </td>
                        <td>
                            <span class="quantity-badge <%= data[i].quantity < 10 ? 'low-stock' : '' %>">
                                <%= data[i].quantity %>
                            </span>
                        </td>
                        <td>
                            <% if(data[i].isBlocked==false) { %>
                                <button id="btn-action<%=data[i]._id%>" class="btn-action btn-block" onclick="blockProducts('<%= data[i]._id %>')">
                                    <i class="fa fa-ban"></i> Block
                                </button>
                            <% } else { %>
                                <button id="btn-action<%=data[i]._id%>" class="btn-action btn-unblock" onclick="blockProducts('<%= data[i]._id %>')">
                                    <i class="fa fa-check"></i> Unblock
                                </button>
                            <% } %>
                        </td>
                        <td>
                            <a href="/admin/edit-product?id=<%= data[i]._id %>" class="btn-action btn-edit">
                                <i class="fa fa-pen"></i> Edit
                            </a>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>

            <!-- Pagination -->
            <div class="pagination-wrapper">
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <a class="page-btn <%= (i === currentPage) ? 'active' : '' %>" href="/admin/products?page=<%= i %>&prod=<%= queryVal.prod || '' %>&cate=<%= queryVal.cate || '' %>&brand=<%= queryVal.brand || '' %>"><%= i %></a>
                <% } %>
            </div>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="/js/admin/product.js"></script>

<%- include("../../views/admin/partials/footer") %>