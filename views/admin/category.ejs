<%- include("../../views/admin/partials/header") %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin/category.css">

<section class="category-page">
  <div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header">
      <h1 class="page-title">
        <div class="page-title-icon">
          <i class="fa fa-folder-tree"></i>
        </div>
        Categories
      </h1>
    </div>

    <!-- Search Bar -->
    <div class="search-container">
      <form action="/admin/category/" method="get" style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">
        <div class="search-input-wrapper">
          <i class="fa fa-search"></i>
          <input type="text" value="<%=search%>" class="search-input" placeholder="Search categories..." name="search" id="search-bar"/>
        </div>
        <button class="search-btn search-btn-primary" type="submit" id="search-button">
          <i class="fa fa-search"></i> Search
        </button>
        <button class="search-btn search-btn-secondary" type="button" onclick="clearSearchBar()">
          <i class="fa fa-times"></i> Clear
        </button>
      </form>
    </div>

    <!-- Main Content -->
    <div class="content-grid">
      <!-- Add Category Form -->
      <div class="add-category-card">
        <div class="add-category-header">
          <h3><i class="fa fa-plus-circle"></i> Add New Category</h3>
        </div>
        <div class="add-category-body">
          <form method="post" action="/admin/add-category" onsubmit="return handleFormSubmit(event)">
            <div class="form-group">
              <label class="form-label">Category Name</label>
              <input type="text" name="name" placeholder="Enter category name" class="form-control" id="product_name" required/>
              <div id="name-error" class="error-message"></div>
            </div>
            <div class="form-group">
              <label class="form-label">Description</label>
              <textarea placeholder="Enter category description" name="description" class="form-control" id="descriptionId" required></textarea>
              <div id="description-error" class="error-message"></div>
            </div>
            <button class="btn-create" type="submit">
              <i class="fa fa-plus"></i> Create Category
            </button>
          </form>
        </div>
      </div>

      <!-- Categories Table -->
      <div class="categories-card">
        <div class="categories-header">
          <h3><i class="fa fa-list" style="color: var(--primary); margin-right: 0.5rem;"></i> All Categories</h3>
          <span class="category-count"><%= cat.length %> categories</span>
        </div>
        <div class="table-container">
          <table class="categories-table">
            <thead>
              <tr>
                <th>Category Name</th>
                <th>Description</th>
                <th>Offer</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="tBody">
              <% cat.reverse().forEach((category, index) => { %>
              <tr id="row<%=category._id%>">
                <td>
                  <span class="category-name"><%= category.name %></span>
                </td>
                <td>
                  <span class="category-desc" title="<%= category.description %>"><%= category.description %></span>
                </td>
                <td>
                  <% if(category.categoryOffer){ %>
                    <span id="offerBadge<%=category._id%>" class="offer-badge has-offer">
                      <i class="fa fa-tag"></i> <%= category.categoryOffer %>%
                    </span>
                  <% } else { %>
                    <span id="offerBadge<%=category._id%>" class="offer-badge no-offer">
                      <i class="fa fa-tag"></i> 0%
                    </span>
                  <% } %>
                </td>
                <td>
                  <% if(category.isListed){ %>
                    <span id="listStatus<%=category._id%>"class="status-badge listed">
                      <span class="status-dot"></span> Listed
                    </span>
                  <% } else { %>
                    <span id="listStatus<%=category._id%>" class="status-badge unlisted">
                      <span class="status-dot"></span> Unlisted
                    </span>
                  <% } %>
                </td>
                <td>
                  <div class="action-buttons">
                    <% if(category.categoryOffer === 0){ %>
                      <a href="#" id="offerBtn<%=category._id%>" class="action-btn action-btn-offer" onclick="addOffer('<%=category._id%>')">
                        <i class="fa fa-percent"></i> Add Offer
                      </a>
                    <% } else { %>
                      <a href="#" id="offerBtn<%=category._id%>" class="action-btn action-btn-offer" onclick="removeOffer('<%=category._id%>')">
                        <i class="fa fa-times"></i> Remove
                      </a>
                    <% } %>
                    
                    <% if(category.isListed){ %>
                      <button id="changeStatus<%=category._id%>"class="action-btn action-btn-unlist" onclick="unlistlistCategory('<%=category._id%>')"><i class="fa fa-eye"></i>Unlist</button>
                    <% } else { %>
                       <button id="changeStatus<%=category._id%>" class="action-btn action-btn-list" onclick="unlistlistCategory('<%=category._id%>')"><i class="fa fa-eye"></i>List</button>
                    <% } %>
                    
                    <a href="/admin/edit-category?id=<%= category._id %>" class="action-btn action-btn-edit">
                      <i class="fa fa-pen"></i> Edit
                    </a>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="pagination-container">
          <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>" class="pagination-btn">
              <i class="fa fa-chevron-left"></i> Previous
            </a>
          <% } %>
          
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === currentPage) { %>
              <span class="pagination-btn active"><%= i %></span>
            <% } else { %>
              <a href="?page=<%= i %>" class="pagination-btn"><%= i %></a>
            <% } %>
          <% } %>
          
          <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>" class="pagination-btn">
              Next <i class="fa fa-chevron-right"></i>
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="/js/admin/category.js"></script>

<%- include("../../views/admin/partials/footer") %>