<%- include("../../views/admin/partials/header") %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6 mt-60">
      <form id="editform" action="#">
        <div class="d-grid text-end mt-30 col-md-5">
          <button
            class="btn btn-primary"
            onclick="editCategory('<%=category._id%>')"
          >
            Update category
          </button>
        </div>
        <div class="mb-4 mt-30">
          <label for="product_name" class="form-label">Name</label>
          <input
            id="name"
            type="text"
            name="categoryName"
            value="<%= category.name %>"
            class="form-control border"
          />
        </div>

        <div class="mb-4">
          <label class="form-label">Description</label>
          <textarea
            id="description"
            name="description"
            class="form-control border"
          >
<%= category.description %></textarea
          >
        </div>
      </form>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

  function validateInputs(name){
    const categoryRegex = /^[A-Za-z]+$/;

    if(categoryRegex.test(name)){
      return true
    }

    return false
  }

  function editCategory(id) {
    event.preventDefault();
    let name = document.getElementById('name').value;
    let description = document.getElementById('description').value;

    if(!validateInputs()){
      Swal.fire({
        title:"Error",
        text:"Enter a valid category name",
        icon:"error"
      })
      return;
    }
    
    fetch(`/admin/edit-category/${id}`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ name, description }),
    })
      .then((res) => res.json())
      .then((data) => {
        if (data.success == true) {
          Swal.fire({
            title: 'Success',
            text: data.message,
            icon: 'success',
          }).then(() => {
            window.location.href = `/admin/category`;
          });
        } else {
          Swal.fire({
            title: 'Error',
            text: data.message,
            icon: 'error',
          });
        }
      });
  }
</script>
<%- include("../../views/admin/partials/footer") %>
