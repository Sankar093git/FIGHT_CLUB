<%- include("../../views/admin/partials/header") %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/css/admin/brand.css" type="text/css">
<section class="brands-page">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <div class="page-title-icon">
                    <i class="fa fa-tags"></i>
                </div>
                Brands
            </h1>
        </div>

        <div class="content-grid">
            <!-- Add Brand Form -->
            <div class="form-card">
                <div class="form-card-header">
                    <h3><i class="fa fa-plus-circle"></i> Add New Brand</h3>
                </div>
                <div class="form-card-body">
                    <form onsubmit="addBrand(event)">
               <div class="form-group">
                <label class="form-label">Brand Name</label>
                <input type="text" name="name" id="brandName" class="form-input" required />
              </div>

               <div class="form-group">
  <label class="form-label">Brand Logo</label>
  <div class="file-upload-wrapper" id="uploadWrapper">
    <img id="imagePreview" src="" alt="Preview" style="display: none; max-width: 120px; max-height: 120px; border-radius: 8px; margin-bottom: 10px;" />
    <i class="fa fa-cloud-upload-alt" id="uploadIcon"></i>
    <p id="uploadText">Click to upload or drag and drop</p>
    <input type="file" id="imageInput" name="image" accept="image/*" required />
  </div>
</div>

          <button class="btn-submit" type="submit">
             <i class="fa fa-plus"></i> Add Brand
          </button>
     </form>

                </div>
            </div>

            <!-- Brands Table -->
            <div class="table-card">
                <div class="table-card-header">
                    <h3><i class="fa fa-list"></i> All Brands</h3>
                    <span class="brand-count" id="brandCount"><%= count %> brands</span>
                </div>

                <% if (data && data.length > 0) { %>
                <table class="brands-table">
                    <thead>
                        <tr>
                            <th>Brand</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <% data.forEach((brand, index) => { %>
                        <tr data-brand-id="<%= brand._id %>">
                            <td>
                                <div class="brand-info">
                                    <div class="brand-logo">
                                        <img src="/uploads/others/<%= brand.logo %>" alt="<%= brand.brandName %>" />
                                    </div>
                                    <span class="brand-name"><%= brand.brandName %></span>
                                </div>
                            </td>
                            <td>
                                <% if(brand.isBlocked) { %>
                                    <span class="status-badge blocked" id="badge<%=brand._id%>">
                                        <i class="fa fa-circle"></i> Blocked
                                    </span>
                                <% } else { %>
                                    <span class="status-badge active" id="badge<%=brand._id%>">
                                        <i class="fa fa-circle"></i> Active
                                    </span>
                                <% } %>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <% if(!brand.isBlocked) { %>
                                        <button class="btn-action block-btn btn-block" data-brand-id="<%= brand._id %>">
                                                <i class="fa fa-ban"></i> Block
                                            </a>
                                        </button>
                                    <% } else { %>
                                        <button class="btn-action block-btn btn-unblock" data-brand-id="<%= brand._id %>">
                                                <i class="fa fa-check-circle"></i> Unblock
                                            </a>
                                        </button>
                                    <% } %>
                                    <button class="btn-action btn-delete" onclick="return confirmDelete('<%= brand._id %>')">
                                            <i class="fa fa-trash"></i> Delete
                                    </button>
                                    <button class="btn-action btn-edit" data-brand-id="<%= brand._id %>" data-brand-name="<%= brand.brandName %>"data-brand-image="<%= brand.logo %>" >
                                            <i class="fa fa-pencil"></i> Edit
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fa fa-tags"></i>
                    </div>
                    <h3>No brands found</h3>
                    <p>Add your first brand using the form</p>
                </div>
                <% } %>
            </div>
        </div>
    </div>
    <% if (totalPages > 1) { %>
<div class="pagination-wrapper">
    <% if (currentPage > 1) { %>
        <a class="page-btn nav-btn" href="/admin/brands?page=<%= currentPage - 1 %>">
            <i class="fa fa-chevron-left"></i> Prev
        </a>
    <% } else { %>
        <span class="page-btn nav-btn disabled"><i class="fa fa-chevron-left"></i> Prev</span>
    <% } %>
    
    <% for (let i = 1; i <= totalPages; i++) { %>
        <a class="page-btn <%= currentPage === i ? 'active' : '' %>" href="/admin/brands?page=<%= i %>"><%= i %></a>
    <% } %>
    
    <% if (currentPage < totalPages) { %>
        <a class="page-btn nav-btn" href="/admin/brands?page=<%= currentPage + 1 %>">
            Next <i class="fa fa-chevron-right"></i>
        </a>
    <% } else { %>
        <span class="page-btn nav-btn disabled">Next <i class="fa fa-chevron-right"></i></span>
    <% } %>
</div>
<% } %>
</section>

<script src="/js/admin/brand.js"></script>

<%- include("../../views/admin/partials/footer") %>