<%- include("../../views/admin/partials/header") %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="/css/admin/customer.css" type="text/css">


<section class="customers-page">
    <div class="container-fluid">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <div class="page-title-icon">
                    <i class="fa fa-users"></i>
                </div>
                Customers
            </h1>
        </div>

        <!-- Stats Row -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon primary">
                    <i class="fa fa-users"></i>
                </div>
                <div class="stat-info">
                    <h3><%= totalData.length %></h3>
                    <p>Total Customers</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon success">
                    <i class="fa fa-user-check"></i>
                </div>
                <div class="stat-info">
                    <h3 id="activeUsers"><%= totalData.filter(d => !d.isBlocked).length %></h3>
                    <p>Active Users</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon danger">
                    <i class="fa fa-user-slash"></i>
                </div>
                <div class="stat-info">
                    <h3 id="blockedUsers"><%= totalData.filter(d => d.isBlocked).length %></h3>
                    <p>Blocked Users</p>
                </div>
            </div>
        </div>

        <!-- Main Content Card -->
        <div class="content-card">
            <!-- Search Header -->
            <div class="card-header-section">
                <form action="/admin/users/" method="get" class="search-wrapper">
                    <i class="fa fa-search"></i>
                    <input type="text" value="<%=queryVal.search%>" class="search-input" placeholder="Search by name, email or phone..." name="search">
                    <% if(queryVal.search) {%>
                         <button class="clear-btn" type="submit" onclick="clearFilter()">Clear</button>
                         <% }else{ %>
                        <button class="search-btn" type="submit">Search</button>
                    <% } %>
                </form>
            </div>

            <!-- Customers Table -->
            <% if (data && data.length > 0) { %>
            <table class="customers-table">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% for(let i = 0; i < data.length; i++) { %>
                    <tr>
                        <td>
                            <div class="customer-info">
                                <div class="customer-avatar">
                                    <%= data[i].name.charAt(0).toUpperCase() %>
                                </div>
                                <span class="customer-name"><%= data[i].name %></span>
                            </div>
                        </td>
                        <td>
                            <div class="customer-email">
                                <i class="fa fa-envelope"></i>
                                <%= data[i].email %>
                            </div>
                        </td>
                        <td>
                            <div class="customer-phone">
                                <i class="fa fa-phone"></i>
                                <%= data[i].phone %>
                            </div>
                        </td>
                        <td>
                            <% if(data[i].isBlocked === false) { %>
                                <button id ="actnBtn<%=data[i]._id%>" class="btn-action btn-block" onclick="blockOrUnblockUser('<%= data[i]._id %>', '<%= data[i].name %>')">
                                    <i class="fa fa-ban"></i> Block
                                </button>
                            <% } else { %>
                                <button id ="actnBtn<%=data[i]._id%>" class="btn-action btn-unblock" onclick="blockOrUnblockUser('<%= data[i]._id %>', '<%= data[i].name %>')">
                                    <i class="fa fa-check-circle"></i> Unblock
                                </button>
                            <% } %>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fa fa-users"></i>
                </div>
                <h3>No customers found</h3>
                <p>Try adjusting your search criteria</p>
            </div>
            <% } %>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
            <div class="pagination-wrapper">
                <% if (currentPage > 1) { %>
                    <a class="page-btn nav-btn" href="/admin/users?page=<%= currentPage - 1 %>">
                        <i class="fa fa-chevron-left"></i> Prev
                    </a>
                <% } %>
                
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <a class="page-btn <%= currentPage === i ? 'active' : '' %>" href="/admin/users?page=<%= i %>"><%= i %></a>
                <% } %>
                
                <% if (currentPage < totalPages) { %>
                    <a class="page-btn nav-btn" href="/admin/users?page=<%= currentPage + 1 %>">
                        Next <i class="fa fa-chevron-right"></i>
                    </a>
                <% } %>
            </div>
            <% } %>
        </div>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="/js/admin/customer.js"></script>

 <%- include("../../views/admin/partials/footer") %>
