<%- include("../../views/user/partials/header.ejs") %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<style>
  body{
    margin-top:30px;
  }
  
  /* Image Zoom Container */
  .zoom-container {
    position: relative;
    overflow: hidden;
    cursor: zoom-in;
    border-radius: 8px;
  }
  
  .zoom-container img {
    transition: transform 0.3s ease;
    width: 100%;
    height: auto;
  }
  
  .zoom-container:hover img {
    transform: scale(2);
  }
  
  /* Thumbnail Gallery */
  .thumbnail-gallery {
    display: flex;
    gap: 10px;
    margin-top: 15px;
    flex-wrap: wrap;
  }
  
  .thumbnail {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border: 2px solid #ddd;
    border-radius: 8px;
    cursor: pointer;
    transition: border-color 0.3s ease, transform 0.2s ease;
  }
  
  .thumbnail:hover {
    border-color: #007bff;
    transform: scale(1.05);
  }
  
  .thumbnail.active {
    border-color: #007bff;
    box-shadow: 0 0 8px rgba(0, 123, 255, 0.5);
  }
  .size-selector-container {
  margin: 1rem 0;
}

.size-label {
  display: block;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: #333;
}

.size-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.size-btn {
  min-width: 42px;
  height: 42px;
  padding: 0 12px;
  border: 1px solid #e0e0e0;
  background: #fff;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.size-btn:hover:not(.out-of-stock) {
  border-color: #333;
  background: #f5f5f5;
}

.size-btn.active {
  border-color: #333;
  background: #333;
  color: #fff;
}

.size-btn.out-of-stock {
  opacity: 0.4;
  cursor: not-allowed;
  text-decoration: line-through;
}

</style>

<main class="main container py-5">
  <!-- Breadcrumbs -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
      <li class="breadcrumb-item active" aria-current="page"><%= product.productName %></li>
    </ol>
  </nav>

  <div class="row g-5">
    <!-- Left: Product Image with Zoom -->
    <div class="col-md-6">
      <div class="zoom-container" id="zoomContainer">
        <img id="mainImage" src="/uploads/re-image/<%= product.productImage[0] %>" alt="<%= product.productName %>" class="img-fluid shadow-sm">
      </div>
      
      <!-- Thumbnail Gallery -->
      <div class="thumbnail-gallery">
        <% product.productImage.forEach((img, index) => { %>
          <img 
            src="/uploads/re-image/<%= img %>" 
            alt="Thumbnail <%= index + 1 %>" 
            class="thumbnail <%= index === 0 ? 'active' : '' %>"
            onclick="changeImage('/uploads/re-image/<%= img %>', this)"
          >
        <% }) %>
      </div>
    </div>

    <!-- Right: Product Details -->
    <div class="col-md-6">
      <h2 class="fw-bold"><%= product.productName %></h2>

      <!-- Ratings -->
      <div class="d-flex align-items-center mb-2">
        <div class="text-warning me-2">
          <% for (let i = 1; i <= 5; i++) { %>
            <i class="bi <%= i <= product.rating ? 'bi-star-fill' : 'bi-star' %>"></i>
          <% } %>
        </div>
        <span>(<%= product.reviewCount %> Reviews)</span>
      </div>

      <!-- Price & Discount -->
      <div class="mb-3">
        <% if (product.salesPrice) { %>
          <h4 class="fw-bold text-danger">₹<%= product.salesPrice %></h4>
          <small class="text-muted text-decoration-line-through">₹<%= product.regularPrice %></small>
          <span class="badge bg-success ms-2">-<%= Math.round(100*(product.regularPrice-product.salesPrice)/product.regularPrice) %>%</span>
        <% } else { %>
          <h4 class="fw-bold">₹<%= product.regularPrice %></h4>
        <% } %>
      </div>

      <!-- Stock Status -->
      <% if (product.available!=true) { %>
        <div class="alert alert-danger">❌ This product is unavailable or blocked.</div>
      <% } else if (product.quantity <= 0) { %>
        <div class="alert alert-warning">⚠️ Out of Stock</div>
      <% } else { %>
        <div class="alert alert-success" id="stock">✅ In Stock: <%= product.variants[0].stock %> items</div>
      <% } %>

 <!-- Size Selector -->
<% if (product.variants && product.variants.length > 0) { %>
<div class="size-selector-container">
  <label class="size-label">Select Size:</label>
  <div class="size-selector">
    <% product.variants.forEach((variant, index) => { %>
      <button type="button" 
              class="size-btn <%= index === 0 ? 'active' : '' %> <%= variant.stock <= 0 ? 'out-of-stock' : '' %>"
              data-size="<%= variant.size %>"
              data-stock="<%= variant.stock %>"
              <%= variant.stock <= 0 ? 'disabled' : '' %>
              onclick="selectSize(this)">
        <%= variant.size %>
      </button>
    <% }) %>
  </div>
  <input type="hidden" id="selectedSize" name="size" value="<%= product.variants[0].size %>">
</div>
<% } %>

<!-- Add to Cart & Wishlist -->
<% if (product.available==true && product.quantity > 0) { %>
  <div class="d-flex gap-2 mt-4">
    <button onclick="handleAddToCart('<%= product._id %>')" class="btn btn-primary px-4">
      <i class="bi bi-cart-plus"></i> Add to Cart
    </button>
    <button onclick="handleAddToWishlist('<%= product._id %>')" class="btn btn-outline-danger px-4">
      <i class="bi bi-heart"></i> Add to Wishlist
    </button>
  </div>
  <!-- Product Highlights / Specifications -->
  <section class="mt-5">
          <h4 class="fw-bold">Highlights</h4>
          <ul class="list-group list-group-flush">
            <li class="list-group-item">✔️ Lightweight running shoe</li>
            <li class="list-group-item">✔️ Breathable mesh upper</li>
            <li class="list-group-item">✔️ Cushioned sole for extra comfort</li>
            <li class="list-group-item">✔️ 1-year warranty</li>
          </ul>
  </section>
<% } else { %>
  <div class="d-flex gap-2 mt-4">
    <button class="btn btn-secondary px-4" disabled>
      <i class="bi bi-cart-x"></i> Unavailable
    </button>
    <button class="btn btn-outline-secondary px-4" disabled>
      <i class="bi bi-heart"></i> Wishlist
    </button>
  </div>
<% } %>


  <!-- Reviews -->
  <section class="mt-5">
    <h4 class="fw-bold">Customer Reviews</h4>

    <!-- Existing Reviews -->
    <% if (product.reviews.length > 0) { %>
      <% product.reviews.forEach(r => { %>
        <div class="border p-3 rounded mb-2">
          <strong><%= r.user.name || "Anonymous" %></strong> 
          <span class="text-warning ms-2">
            <% for (let i = 1; i <= 5; i++) { %>
              <i class="bi <%= i <= r.rating ? 'bi-star-fill' : 'bi-star' %>"></i>
            <% } %>
          </span>
          <p class="mt-2"><%= r.comment %></p>
        </div>
      <% }) %>
    <% } else { %>
      <p class="text-muted">No reviews yet.</p>
    <% } %>

    <!-- Add a Review Form -->
    <% if (locals.user) { %>
      <div class="mt-4">
        <h5>Add Your Review</h5>
        <form id="reviewForm" method="POST" action="/product/<%= product._id %>/review">
          <!-- Rating -->
          <div class="mb-3">
            <label for="rating" class="form-label">Rating</label>
            <select class="form-select" id="rating" name="rating" required>
              <option value="">Choose...</option>
              <option value="5">⭐⭐⭐⭐⭐ (5)</option>
              <option value="4">⭐⭐⭐⭐ (4)</option>
              <option value="3">⭐⭐⭐ (3)</option>
              <option value="2">⭐⭐ (2)</option>
              <option value="1">⭐ (1)</option>
            </select>
          </div>

          <!-- Comment -->
          <div class="mb-3">
            <label for="comment" class="form-label">Your Review</label>
            <textarea class="form-control" id="comment" name="comment" rows="3" required></textarea>
          </div>

          <button type="submit" class="btn btn-success">
            <i class="bi bi-send"></i> Submit Review
          </button>
        </form>
      </div>
    <% } else { %>
      <p class="text-muted mt-3">Please <a href="/login">login</a> to add a review.</p>
    <% } %>
  </section>

  <!-- Related Products -->
  <section class="mt-5">
    <h4 class="fw-bold">Related Products</h4>
    <div class="row row-cols-2 row-cols-md-4 g-4">
      <% relatedProducts.forEach(p => { %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm">
            <img src="/uploads/re-image/<%= p.productImage[0] %>" class="card-img-top" alt="<%= p.productName %>">
            <div class="card-body">
              <h6 class="card-title"><%= p.productName %></h6>
              <p class="text-danger fw-bold">₹<%= p.salesPrice || p.regularPrice %></p>
              <a href="/product-details?id=<%= p._id %>" class="stretched-link"></a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<script>
  function handleAddToCart(productId) {
    fetch(`/add-to-cart/${productId}`, { method: "POST" })
      .then(res => {
        if (res.status === 403) {
          alert("This product is blocked/unavailable.");
          window.location.href = "/shop";
        } else {
          Swal.fire({
            title: 'Success!',
            text: 'Item added to cart',
            icon: 'success',
            confirmButtonText: 'OK'
          }).then(() => {
            location.reload();
          });
        }
      })
      .catch(() => alert("Error adding to cart."));
  }

  function handleAddToWishlist(productId){
    try {
      fetch(`/add-to-wishlist/${productId}`,{
        method:"POST",
        headers:{
          "Content-Type":"application/json"
        },
      }).then((res)=>res.json())
      .then((data)=>{
        if(data.success){
          Swal.fire({
            title:"Success",
            text:`${data.message}`,
            icon:"success",
            confirmButtonText: 'OK'
          })
        }
      })
      
    } catch (error) {
      console.error(error);
      Swal.fire({
        title:"Error!",
        text:"Something went wrong!",
        icon:"error",
        confirmButtonTex: "OK"
      })
    }
  }

  // Image switching function
  function changeImage(imageSrc, thumbnail) {
    // Update main image
    document.getElementById('mainImage').src = imageSrc;
    
    // Update active thumbnail
    document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
    thumbnail.classList.add('active');
  }

  // Enhanced zoom with mouse tracking
  const zoomContainer = document.getElementById('zoomContainer');
  const mainImage = document.getElementById('mainImage');

  zoomContainer.addEventListener('mousemove', (e) => {
    const rect = zoomContainer.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;
    mainImage.style.transformOrigin = `${x}% ${y}%`;
  });

  zoomContainer.addEventListener('mouseleave', () => {
    mainImage.style.transformOrigin = 'center center';
  });

  function selectSize(btn) {
  if (btn.classList.contains('out-of-stock')) return;
  
  document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('selectedSize').value = btn.dataset.size;
}

function handleStockPerSize(){
  try {
    let stock=document.getElementById("stock");
    let btn=document.querySelectorAll(".size-btn").forEach((btn)=>{
          btn.addEventListener("click",()=>{
                stock.innerText=`✅ In Stock: ${btn.getAttribute("data-stock")} items`;
          });
    })
  } catch (error) {
    console.error("Error while switching variants");
  }
}
handleStockPerSize()

</script>

<%- include("../../views/user/partials/footer.ejs") %>