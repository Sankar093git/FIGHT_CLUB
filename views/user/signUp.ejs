<%- include("../../views/user/partials/header.ejs") %>
  <!-- Font Awesome for eye icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <link rel="stylesheet" href="/css/user/signUp.css" type="text/css">
  <main class="form-section my-5">
    <div class="form-container shadow-sm">
      <form id="signform" action="/signup" method="post" enctype="multipart/form-data" novalidate>
  <h3 class="text-center mb-3">SIGN UP</h3>
  <p class="text-muted text-center mb-4">Please fill in the information below:</p>
  <% if(message){%>
  <div id="error-message" class="alert alert-danger text-center" style="display: block;"><%=message %></div>
  <%}else{%>
  <div id="error-message" class="alert alert-danger text-center" style="display: none;"></div>
  <% } %>
<div class="sub-container d-flex gap-2">
  <!-- Profile Image Upload -->
   <div class="mb-3 text-center border p-1">
    <label for="profileImage" class="form-label fw-semibold">Profile Image</label>
    <div class="d-flex flex-column align-items-center">
      <img id="previewImg" src="https://via.placeholder.com/100" alt="Image" class="rounded-circle mb-2" style="width:100px; height:100px; object-fit:cover;">
      <input type="file" class="form-control" name="profileImage" id="profileImage" accept="image/*" />
    </div>
    <div id="error6" class="error-message"></div>
  </div>
<div class="text-section">
  <div class="mb-3">
    <input type="text" class="form-control" placeholder="Full Name" name="name" id="name" />
    <div id="error1" class="error-message"></div>
  </div>

  <div class="mb-3">
    <input type="email" class="form-control" placeholder="Email" name="email" id="email" />
    <div id="error2" class="error-message"></div>
  </div>

  <div class="mb-3">
    <input type="text" class="form-control" placeholder="Phone Number" name="phone" id="phone" />
    <div id="error3" class="error-message"></div>
  </div>

  <!-- Password fields -->
  <div class="mb-3 password-toggle">
    <input type="password" class="form-control" placeholder="Password" name="password" id="password" />
    <i class="fa-solid fa-eye" id="togglePassword"></i>
    <div id="error4" class="error-message"></div>
  </div>

  <div class="mb-3 password-toggle">
    <input type="password" class="form-control" placeholder="Confirm Password" name="cpassword" id="cpassword" />
    <i class="fa-solid fa-eye" id="toggleCPassword"></i>
    <div id="error5" class="error-message"></div>
  </div>

  <div class="mb-3">
    <input type="text" class="form-control" placeholder="Referal code(if any..)" name="referedCode" id="referalCode" />
    <div id="error7" class="error-message"></div>
  </div>

  <div class="d-grid gap-2">
    <button type="submit" class="btn btn-dark">Create Account</button>
    <button type="button" class="btn google-signin text-white" onclick="window.location.href='/auth/google'">
      Sign up with Google
    </button>
  </div>

  <p class="mt-3 text-center text-muted small">
    Already have an account? <a href="/login" class="text-dark fw-semibold">Login</a>
  </p>
  </div>
  </div>
</form>

    </div>
  </main>

  <script src="/js/user/signUp.js"></script>
<%- include("../../views/user/partials/footer.ejs") %>