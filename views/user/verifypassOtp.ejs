<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify OTP</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/user/verifypassOtp.css" type="text/css">
</head>
<body>

  <div class="container">
    <div class="verify-box">
      <h4>Verify OTP</h4>
      <input type="text" class="form-control mt-4" placeholder="enter your OTP" id="otpInput" name="otp">
      <button onclick="confirmOTP()">CONFIRM</button>

      <div class="timer" id="timer">01:00</div>
      <button class="resend-btn" onclick="resendOTP()" disabled id="resendBtn">RESEND OTP</button>
    </div>
  </div>

  
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>


  <script src="/js/user/verifypassOtp.js"></script>

</body>
</html>