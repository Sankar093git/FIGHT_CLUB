<%- include("../../views/user/partials/header.ejs") %>
<link rel="stylesheet" href="/css/user/login.css">
  <!-- Header -->
  <header class="bg-secondary text-white py-3 px-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
      <strong>FIGHT CLUB</strong>
      <nav class="d-flex gap-3">
        <a class="text-white text-decoration-none" href="#">Home</a>
      </nav>
      <div class="d-flex gap-3">
        <a class="text-white text-decoration-none" href="#">Search</a>
        <a class="text-white text-decoration-none" href="#">Cart (0)</a>
      </div>
    </div>
  </header>

  <!-- Main Login Section -->
  <main class="login-section">
    <div class="login-box">
      <h2 class="text-center">LOGIN</h2>
      <% if(message) {%>
      <p class="text-center text-danger"><%= message %></p>
      <%}else{ %>
      <p class="text-center">Enter your email and password to login:</p>
      <% } %>
      <form action="/login" method="post">
        <div class="mb-3">
          <input type="email" class="form-control" name="email" placeholder="E-mail" required>
        </div>
        <div class="mb-2">
          <div class="mb-2 position-relative">
  <input type="password" class="form-control" name="password" id="password" placeholder="Password" required>
  <i class="fa-solid fa-eye" id="togglePassword" style="position: absolute; top: 50%; right: 10px; transform: translateY(-50%); cursor: pointer; color: #888;"></i>
</div>
        </div>
        <div class="mb-3 d-flex justify-content-end">
          <a href="/forgotpassword" class="text-decoration-none text-secondary" style="font-size: 13px;">Forgot your password?</a>
        </div>
        <button type="submit" class="btn btn-dark w-100">LOGIN</button>
        <div class="text-center mt-3" style="font-size: 13px;">
          Don’t have an account? <a href="/signup" class="text-dark text-decoration-none">Sign up</a>
        </div>
      </form>
    </div>
  </main>

  <!-- Bootstrap Bundle with Popper -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/user/login.js"></script>

<%- include("../../views/user/partials/footer.ejs") %>