<%- include("../../views/user/partials/header.ejs") %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="/css/user/cart.css">

<main class="container py-5 cart">
  <h2 class="mb-4 mt-5">My Cart</h2>
  <% if (userData.cart && userData.cart.length > 0) { %>
    <table class="table table-bordered align-middle">
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% let grandTotal = 0; %>
        <% cart.forEach(item => { 
             let itemTotal = item.product.salesPrice * item.quantity;
             grandTotal += itemTotal;
        %>
          <tr id="row<%=item.product._id%>">
            <td>
              <img src="/uploads/re-image/<%= item.product.productImage[0] %>" width="60">
              <%= item.product.productName %>(<%= item.size %>)
              <% if (item.availableStock===0) { %>
                <span class="badge bg-danger">Out of Stock</span>
              <% } %>
            </td>
            <td class="price" id="priceof<%=item.product._id%>">₹<%= item.product.salesPrice %></td>
            <td>
                <button type="submit" name="action" item="<%= item.product._id %>" value="decrement" id="decrement<%= item.product._id %>" class="btn btn-sm dec btn-outline-secondary">-</button>
                <span class="mx-2 quant" id="itemQuant<%=item.product._id%>"><%= item.quantity %></span>
                <button type="submit" name="action" item="<%= item.product._id %>" value="increment" id="increment<%= item.product._id %>"
                        class="btn btn-sm inc btn-outline-secondary"
                        <%= item.product.stock === 0 ? "disabled" : "" %>>+</button>
                  <!-- Trashcan button for remove -->
                <button item="<%= item._id %>" product="<%= item.product._id %>" class="trash-btn">
                  <i class="bi bi-trash"></i>
                </button>
            </td>
            <td class="totalPrice" id="totalPrice<%=item.product._id%>">₹<%= itemTotal %></td>
          </tr>
        <% }) %>
        <!-- Grand Total Row -->
        <tr>
          <td colspan="3" class="text-end fw-bold">Grand Total</td>
          <td class="fw-bold" id="grandTotal">₹<%= grandTotal %></td>
        </tr>
      </tbody>
    </table>

    <div class="text-end">
      <button class="btn btn-primary" onclick="proccedToCheckout()"
         <%= userData.cart.some(item => item.product.stock === 0) ? "disabled" : "" %>>
        Proceed to Checkout
      </button>
    </div>
  <% } else { %>
    <p>Your cart is empty.</p>
  <% } %>

</main>
<script src="/js/user/cart.js"></script>

<%- include("../../views/user/partials/footer.ejs") %>


