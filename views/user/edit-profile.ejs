<%- include("../../views/user/partials/header.ejs") %>
<link rel="stylesheet" href="/css/user/edit-profile.css" type="text/css">

<div class="container mainDiv mt-5" style="max-width: 600px;">
  <h2 class="mb-4">Edit Profile</h2>

  <form id="editProfileForm">
    <div class="mb-3">
      <label class="form-label">Username</label>
      <input id="username" type="text" name="username" class="form-control" value="<%= userData.name %>" required>
      <span id="error1" class="error-text"></span>
    </div>

    <div class="mb-3">
      <label class="form-label">Email</label>
      <input id="email" type="email" name="email" class="form-control" value="<%= userData.email %>" required>
      <span id="error2" class="error-text"></span>
    </div>

    <div class="mb-3">
      <label class="form-label">Phone</label>
      <input id="phone" type="tel" name="phone" class="form-control" value="<%= userData.phone %>" required>
      <span id="error3" class="error-text"></span>
    </div>

    <div class="mb-3">
      <label class="form-label">New Password</label>
      <input id="password" type="password" name="password" class="form-control" placeholder="Enter new password (leave blank to keep current)">
      <span id="error4" class="error-text"></span>
    </div>

    <button type="submit" class="btn btn-success">Save Changes</button>
    <a href="/profile" class="btn btn-secondary">Cancel</a>
  </form>
</div>

<script src="/js/user/edit-profile.js"></script>

<%- include("../../views/user/partials/footer.ejs") %>
