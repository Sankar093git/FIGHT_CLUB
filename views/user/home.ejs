                    <button class="btn btn-primary btn-lg">SHOP NOW</button>
                </div>
            </div> 
        </div>
        <!-- Carousel Structure -->
<div id="myCarousel" class="carousel slide" data-bs-ride="carousel" >
  <!-- Indicators/dots -->
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="0" class="active"></button>
    <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="1"></button>
    <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="2"></button>
  </div>

  <!-- Carousel inner items -->
  <div class="carousel-inner ">
    <div class="carousel-item active">
      <img src="/Images/FightClub_Banner_1.webp" class="img-fluid w-100 object-fit cover" alt="Slide 1">
    </div>
    <div class="carousel-item">
      <img src="/Images/FightClub_Banner_2.webp" class="d-block w-100" alt="Slide 2">
    </div>
    <div class="carousel-item">
      <img src="/Images/FightClub_Banner-6.jpg" class="d-block w-100" alt="Slide 3">
    </div>
  </div>

  <!-- Controls/arrows -->
  <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>
</div>

