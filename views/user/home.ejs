
<%- include("../user/partials/header.ejs") %>
  <link rel="stylesheet" href="/css/user/home.css" type="text/css">
    <!-- Hero Section -->
   <section class="hero-section">
        <div class="container floating-content">
            <div class="row">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold mb-4">FIGHT CLUB</h1>
                    <p class="lead mb-4">Premium martial arts equipment for champions</p>
                    <button class="btn btn-primary btn-lg">SHOP NOW</button>
                </div>
            </div> 
        </div>
        <!-- Carousel Structure -->
<div id="myCarousel" class="carousel slide" data-bs-ride="carousel" >
  <!-- Indicators/dots -->
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="0" class="active"></button>
    <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="1"></button>
    <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="2"></button>
  </div>

  <!-- Carousel inner items -->
  <div class="carousel-inner ">
    <div class="carousel-item active">
      <img src="/Images/FightClub_Banner_1.webp" class="img-fluid w-100 object-fit cover" alt="Slide 1">
    </div>
    <div class="carousel-item">
      <img src="/Images/FightClub_Banner_2.webp" class="d-block w-100" alt="Slide 2">
    </div>
    <div class="carousel-item">
      <img src="/Images/FightClub_Banner-6.jpg" class="d-block w-100" alt="Slide 3">
    </div>
  </div>

  <!-- Controls/arrows -->
  <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>
</div>

    </section>
    <!-- Categories Section -->
    <section class="py-5">
        <div class="container">
            <div class="row">
                <div class="col-md-2 col-sm-4 col-6 mb-4">
                    <div class="text-center position-relative">
                        <div class="category-icon">
                            <i class="fas fa-hand-rock"></i>
                        </div>
                        <h6 class="fw-bold"><a href="/shop?cate=Karate" class="stretched-link text-decoration-none text-dark">KARATE</a>
                        </h6>
                    </div>
                </div>
                <div class="col-md-2 col-sm-4 col-6 mb-4">
                    <div class="text-center position-relative">
                        <div class="category-icon">
                            <i class="fas fa-fist-raised"></i>
                        </div>
                        <h6 class="fw-bold"><a href="/shop?cate=Boxing" class="stretched-link text-decoration-none text-dark">BOXING</a>
                        </h6>
                    </div>
                </div>
                <div class="col-md-2 col-sm-4 col-6 mb-4">
                    <div class="text-center position-relative">
                        <div class="category-icon">
                            <i class="fas fa-running"></i>
                        </div>
                        <h6 class="fw-bold"><a href="/shop?cate=Kickboxing" class="stretched-link text-decoration-none text-dark">KICKBOXING</a>
                        </h6>
                    </div>
                </div>
                <div class="col-md-2 col-sm-4 col-6 mb-4">
                    <div class="text-center position-relative">
                        <div class="category-icon">
                            <i class="fas fa-user-ninja"></i>
                        </div>
                        <h6 class="fw-bold"><a href="/shop?cate=Wrestling" class="stretched-link text-decoration-none text-dark">WRESTLING</a>
                        </h6>
                    </div>
                </div>
                <div class="col-md-2 col-sm-4 col-6 mb-4">
                    <div class="text-center position-relative">
                        <div class="category-icon">
                            <i class="fas fa-hand-paper"></i>
                        </div>
                        <h6 class="fw-bold"><a href="/shop?cate=MuayThai" class="stretched-link text-decoration-none text-dark">MUAY-THAI</a>
                        </h6>
                    </div>
                </div>
                <div class="col-md-2 col-sm-4 col-6 mb-4">
                    <div class="text-center position-relative">
                        <div class="category-icon">
                            <i class="fas fa-user-shield"></i>
                        </div>
                        <h6 class="fw-bold"><a href="/shop?cate=JiuJitsu" class="stretched-link text-decoration-none text-dark">JIU-JITSU</a>
                        </h6>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Brand Section -->
    <section class="py-5 bg-light">
        <div class="container text-center">
            <h2 class="section-title">FIGHT CLUB</h2>
            <p class="lead">Tailor Made Equipments | Designed for Maximum Protection</p>
        </div>
    </section>

    <!-- Most Wanted Section -->
     <% if(mostWanted){%>
    <section class="py-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold">MOST WANTED STUFF</h3>
                <div class="btn-group">
                    <button class="btn btn-outline-secondary btn-sm" onclick="scrollProducts('left', 'most-wanted')">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="scrollProducts('right', 'most-wanted')">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
            <div class="row" id="most-wanted">
                 <% for(let item of mostWanted){%>
               <div class="col-lg-3 col-md-6 mb-4">
                 <div class="card product-card position-relative"> 
                   <img src="/uploads/re-image/<%=item.image%>" class="card-img-top product-image" alt="Gi">
                     <div class="card-body">
                       <h6 class="card-title">
                          <a href="/product-details?id=<%=item._id%>" class="stretched-link text-decoration-none text-dark">
                            <%=item.name%>
                         </a>
                      </h6>
                     <p class="price text-success">₹<%=item.salePrice%></p>
                  </div>
                </div>
             </div>
                <%}%>
            </div>
        </div>
    </section>
    <% }%>

    <!-- What's New Section -->
     <% if(latestProducts){%>
    <section class="py-5 bg-light">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold">WHAT'S NEW</h3>
                <div class="btn-group">
                    <button class="btn btn-outline-secondary btn-sm" onclick="scrollProducts('left', 'whats-new')">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="scrollProducts('right', 'whats-new')">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
            <div class="row" id="whats-new">
                <% for(let item of latestProducts) {%>
                <div class="col-lg-3 col-md-6 mb-4">
                <div class="card product-card position-relative">
                   <img src="/uploads/re-image/<%=item.productImage[0]%>" class="card-img-top product-image" alt="Karate Gi">
                   <div class="card-body">
                     <h6 class="card-title">
                       <a href="/product-details?id=<%=item._id%>" class="stretched-link text-decoration-none text-dark">
                        <%=item.productName%>
                       </a>
                    </h6>
                   <p class="price text-success">₹<%=item.salesPrice%></p>
                </div>
              </div>
            </div>
                <% } %>
            </div>
        </div>
    </section>
    <% } %>

    <!-- Testimonials Section -->
    <section class="py-5">
        <div class="container">
            <h3 class="text-center mb-5">Check what our business say about us!</h3>
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="testimonial-card">
                        <div class="mb-3">
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                        </div>
                        <p>"Excellent quality equipment. Been using Fight Club gear for 2 years now."</p>
                        <h6 class="fw-bold">Mike Johnson</h6>
                        <small class="text-muted">Professional Boxer</small>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="testimonial-card">
                        <div class="mb-3">
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                        </div>
                        <p>"Best martial arts equipment I've ever used. Highly recommended!"</p>
                        <h6 class="fw-bold">Sarah Chen</h6>
                        <small class="text-muted">MMA Fighter</small>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="testimonial-card">
                        <div class="mb-3">
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                            <i class="fas fa-star text-warning"></i>
                        </div>
                        <p>"Durable and comfortable. Perfect for intense training sessions."</p>
                        <h6 class="fw-bold">Carlos Rodriguez</h6>
                        <small class="text-muted">Muay Thai Instructor</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4 mb-4">
                    <i class="fas fa-shipping-fast fa-3x text-primary mb-3"></i>
                    <h5>Free Shipping</h5>
                    <p>Free shipping on orders over $100</p>
                </div>
                <div class="col-md-4 mb-4">
                    <i class="fas fa-medal fa-3x text-primary mb-3"></i>
                    <h5>Quality Guarantee</h5>
                    <p>Premium quality martial arts equipment</p>
                </div>
                <div class="col-md-4 mb-4">
                    <i class="fas fa-headset fa-3x text-primary mb-3"></i>
                    <h5>24/7 Support</h5>
                    <p>Round the clock customer support</p>
                </div>
            </div>
        </div>
    </section>
    <script src="/js/user/home.js"></script>
<%- include("../user/partials/footer.ejs") %>