<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Failed</title>

  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <style>
    body {
      background-color: #f8f9fa;
    }

    .failure-wrapper {
      max-width: 1000px;
      width: 100%;
    }

    .failure-illustration img {
      max-height: 320px;
    }

    .error-dot {
      width: 8px;
      height: 8px;
      background-color: #dc3545;
      border-radius: 50%;
      margin-top: 6px;
      flex-shrink: 0;
    }
  </style>
</head>

<body>

  <div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div class="card shadow-lg border-0 failure-wrapper">
      <div class="row g-0 align-items-center">

        <!-- Left: Illustration -->
        <div class="col-md-5 text-center p-4 failure-illustration">
          <img
            src="/public/uploads/others/transaction-failed.png"
            alt="Payment Failed"
            class="img-fluid"
          />
        </div>

        <!-- Right: Content -->
        <div class="col-md-7 p-5">

          <h1 class="fw-bold mb-3">Payment Failed</h1>

          <p class="text-muted mb-4">
            We couldn't process your payment. This could be due to insufficient
            funds, an expired card, or a temporary issue with your bank.
          </p>

          <!-- Error Details -->
          <div class="alert alert-danger bg-danger bg-opacity-10 border border-danger border-opacity-25 mb-4">
            <div class="d-flex gap-2">
              <span class="error-dot"></span>
              <div>
                <p class="mb-0 fw-semibold">
                  Error Code: PAYMENT_DECLINED
                </p>
                <small class="text-muted">
                  ORDER ID: <%= orderId %>
                </small>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="d-flex flex-wrap gap-3 mb-4">
            <a href="retry-payment.html" class="btn btn-danger btn-lg">
              <i class="bi bi-arrow-repeat me-2"></i>
              Retry Payment
            </a>

            <a href="order-details.html" class="btn btn-outline-secondary btn-lg">
              <i class="bi bi-file-earmark-text me-2"></i>
              View Order Details
            </a>
          </div>

          <!-- Back Link -->
          <a
            href="index.html"
            class="text-muted text-decoration-none d-inline-flex align-items-center"
          >
            <i class="bi bi-arrow-left me-1"></i>
            Back to Home
          </a>

        </div>
      </div>
    </div>
  </div>

</body>
</html>

