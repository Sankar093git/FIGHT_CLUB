<%- include("../../views/user/partials/header.ejs") %>
<link rel="stylesheet" href="/css/user/shop.css" type="text/css">

<div class="container" style="margin-top: 64px; padding-top: 40px;">
  <div class="row">
    <!-- Sidebar: search + filters -->
    <div class="col-md-3">
      <!-- Search form: includes hidden inputs so search submits keep current filters -->
      <form id="searchForm" action="/shop" method="get" class="">
        <div class="search-bar col-sm-6 col-md-3 col-lg-6 pb-3 d-flex">
          <input type="text" name="search"
                 value="<%= typeof search !== 'undefined' ? search : '' %>"
                 class="rounded-start-3 px-2 searchInput" placeholder="search..." />
          <% if (typeof search !== 'undefined' && search !== '') { %>
            <a href="/shop" class="btn search-button rounded-end-3" style="background-color:darkgrey; color:white">
              CLEAR
            </a>
          <% } else { %>
            <button type="submit" class="btn search-button rounded-end-3" style="background-color:darkgrey; color:white">
              SEARCH
            </button>
          <% } %>
        </div>

        <!-- Hidden inputs so the search submit keeps current filters -->
        <input type="hidden" name="cate" value="<%= cate || '' %>">
        <input type="hidden" name="bran" value="<%= bran || '' %>">
        <input type="hidden" name="sort" value="<%= sort || '' %>">
        <input type="hidden" name="minPrice" value="<%= minPrice || '' %>">
        <input type="hidden" name="maxPrice" value="<%= maxPrice || '' %>">
      </form>

      <!-- Filters (JS-driven so each change preserves ALL existing params) -->
      <div class="filter-section">
        <h5>Filters</h5>
        <hr>

        <!-- Category -->
        <div class="mb-3">
          <label class="form-label">Category</label>
          <select class="form-select" onchange="updateQueryParam('cate', this.value)">
            <option value="">All</option>
            <% for (let i = 0; i < category.length; i++) { %>
              <option value="<%= category[i].name %>" <%= (cate === category[i].name) ? "selected" : '' %>>
                <%= category[i].name %>
              </option>
            <% } %>
          </select>
        </div>

        <!-- Sort -->
        <div class="mb-3">
          <label class="form-label">Sort by</label>
          <select class="form-select" onchange="updateQueryParam('sort', this.value)">
            <option value="" <%= !sort ? 'selected' : '' %>>Aa-Zz</option>
            <option value="desc" <%= sort === 'desc' ? 'selected' : '' %>>Zz-Aa</option>
            <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Price (low-high)</option>
            <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Price (high-low)</option>
          </select>
        </div>

        <!-- Brand -->
        <div class="mb-3">
          <label class="form-label">Brand</label>
          <select class="form-select" onchange="updateQueryParam('bran', this.value)">
            <option value="">All</option>
            <% for (let i = 0; i < brand.length; i++) { %>
              <option value="<%= brand[i].brandName %>" <%= (bran === brand[i].brandName) ? 'selected' : '' %>>
                <%= brand[i].brandName %>
              </option>
            <% } %>
          </select>
        </div>

        <!-- Price Range -->
        <div style="width: 300px;" class="mx-auto my-4">
          <label class="form-label">Price Range:</label>
          <div class="d-flex justify-content-between mb-2">
            <span>Min: ₹<span id="minValue"><%= minPrice || 100 %></span></span>
            <span>Max: ₹<span id="maxValue"><%= maxPrice || 900 %></span></span>
          </div>

          <input type="range" class="form-range" id="minRange" min="0" max="10000"
                 value="<%= minPrice || 100 %>" step="10" oninput="document.getElementById('minValue').innerText=this.value">
          <input type="range" class="form-range" id="maxRange" min="0" max="10000"
                 value="<%= maxPrice || 900 %>" step="10" oninput="document.getElementById('maxValue').innerText=this.value">

          <div class="mt-2">
            <button type="button" class="btn btn-sm btn-outline-primary mb-4 w-100" onclick="applyPriceFilter()">
              Apply Price
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger mb-4 w-100" onclick="clearFilters()">
              Clear-filters
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Product grid -->
    <div class="col-md-9">
      <div class="row" id="product-list">
        <!-- client-side rendering below -->
      </div>

      <!-- Pagination (EJS builds links that include all active params) -->
      <nav class="mt-4">
        <ul class="pagination justify-content-center">
          <% for (let i = 1; i <= totalPages; i++) {
               let parts = [];
               parts.push('page=' + i);
               if (typeof search !== 'undefined' && search) parts.push('search=' + encodeURIComponent(search));
               if (typeof cate !== 'undefined' && cate) parts.push('cate=' + encodeURIComponent(cate));
               if (typeof bran !== 'undefined' && bran) parts.push('bran=' + encodeURIComponent(bran));
               if (typeof sort !== 'undefined' && sort) parts.push('sort=' + encodeURIComponent(sort));
               if (typeof minPrice !== 'undefined' && minPrice) parts.push('minPrice=' + encodeURIComponent(minPrice));
               if (typeof maxPrice !== 'undefined' && maxPrice) parts.push('maxPrice=' + encodeURIComponent(maxPrice));
               const href = '/shop?' + parts.join('&');
          %>
            <li class="page-item <%= (i === currentPage) ? 'active' : '' %>">
              <a class="page-link" href="<%= href %>"><%= i %></a>
            </li>
          <% } %>
        </ul>
      </nav>
    </div>
  </div>
</div>

<script>
/* ---------------------------------------------------------
     1. Inject backend data safely into JS
  --------------------------------------------------------- */
  const products = <%- JSON.stringify(product || []) %>;
  const wishList = <%- JSON.stringify(wishList || []) %>;
  const productList = document.getElementById("product-list");

  /* ---------------------------------------------------------
     2. Generic URL helper (avoids repeating logic)
  --------------------------------------------------------- */
  function updateURLParams(updates = {}) {
    const url = new URL(window.location.href);

    Object.keys(updates).forEach(key => {
      const value = updates[key];
      if (value === "" || value === null || value === undefined) {
        url.searchParams.delete(key);
      } else {
        url.searchParams.set(key, value);
      }
    });

    // always reset pagination when filters change
    url.searchParams.delete("page");

    window.location.href = url.pathname + "?" + url.searchParams.toString();
  }

  /* ---------------------------------------------------------
     3. Handlers for Filters
  --------------------------------------------------------- */
  function updateQueryParam(key, value) {
    updateURLParams({ [key]: value });
  }

  function applyPriceFilter() {
    const min = document.getElementById("minRange").value;
    const max = document.getElementById("maxRange").value;
    updateURLParams({ minPrice: min, maxPrice: max });
  }

  /* ---------------------------------------------------------
     4. Render Product Cards
  --------------------------------------------------------- */
  function renderProducts(container, data, wishList) {
    container.innerHTML = "";

    data.forEach(p => {

      const inWishlist=wishList.includes(p._id);

      const discount =
        p.regularPrice > p.salesPrice? Math.round(((p.regularPrice - p.salesPrice) / p.regularPrice) * 100): 0;

      const mainImage =
        p.productImage && p.productImage[0]? `/uploads/re-image/${p.productImage[0]}`: "/uploads/re-image/placeholder.jpg";

      const card = document.createElement("div");
      card.className = "col-md-4 mb-4";

      card.innerHTML = `
  <div class="card product-card h-100">
    
  <div class="position-relative d-flex justify-content-center">
    <a href="/product-details?id=${p._id}">
      <img src="${mainImage}" class="card-img-top" alt="${p.productName}">
    </a>
    <div class="position-absolute top-0 end-0 p-2">
      <i class="${inWishlist ? 'fa-solid' : 'fa-regular'} fa-heart text-danger wishBtn" data-id='${p._id}'' data-wish='${inWishlist}' onclick='toggleWishbtn(this)'></i>
    </div>  
  </div>

  <div class="card-body d-flex flex-column align-items-center">
    <h6 class="card-title text-center mb-2">${p.productName}</h6>
    <span class="original-price me-2">
      Size: ${p.variants[0].size}
    </span>

    <div class="price-section mb-3">
      ${p.regularPrice !== p.salesPrice ? `
        <span class="original-price text-muted text-decoration-line-through me-2">
          ₹${p.regularPrice}
        </span>
      ` : ''}
      <span class="sale-price fw-bold text-danger">₹${p.salesPrice}</span>
    </div>

    <button onclick="handleAddToCart('${p._id}','${p.variants[0].size}')" class="btn btn-add-cart">
      <i class="bi bi-cart-plus me-1"></i> Add to Cart
    </button>
  </div>
</div>
`;

      container.appendChild(card);
    });
  }

  /* ---------------------------------------------------------
     5. Execute Render
  --------------------------------------------------------- */
  renderProducts(productList, products, wishList);

function handleAddToCart(productId,size){
  fetch(`/add-to-cart/${productId}`,{
    method:"POST",
    headers:{
      "content-type":"application/json"
    },
    body:JSON.stringify({size})
  }).then(res => {
        if (res.status === 403) {
          Swal.fire({
          icon: "error",
          title: "Oops!",
          text: "This product is blocked or unavailable at the moment.",
          confirmButtonColor: "#d33",
        }).then(()=>{
          window.location.href = "/shop";
        })
        } else {
          Swal.fire({
            title: 'Success!',
            text: 'Item added to cart',
            icon: 'success',
            confirmButtonText: 'OK'
          }).then(()=>{
            let cText = document.querySelector(".cartCount").innerText; 
            let match = cText.match(/\d+/); 
            let count = match ? parseInt(match[0]) : 0; 
            count++;
            document.querySelector(".cartCount").innerText = `CART(${count})`;
          })
        }
      })
      .catch(() => Swal.fire({
                     icon: 'error',
                     title: 'Add to Cart Failed',
                     text: 'Something went wrong. Please try again.',
                     confirmButtonColor: '#d33'
                    }));
  }

  function clearFilters(){
    window.location.href="/shop"
  }

  function toggleWishbtn(el) {
  const productId = el.dataset.id;
  const inWishlist = el.dataset.wish;

  if (inWishlist=='true') {
    removeFromWishlist(productId, el);
  } else {
    addToWishlist(productId, el);
  }
}

function addToWishlist(productId,el){

  fetch(`/add-to-wishlist/${productId}`,{
    method:"POST",
  }).then(res=>res.json())
  .then((data)=>{
    console.log(data)
    if(data.success){
      el.dataset.wish=true;
      el.classList.replace("fa-regular","fa-solid");

      let wishIcon = document.getElementById('wishIcon');
      let currentCount = parseInt(wishIcon.innerText.trim()) || 0;
      wishIcon.innerText = currentCount + 1;
    }else{
      Swal.fire({
        title:"Oops",
        text:"Please try again!",
        icon:"error"
      })
    }
  })
}

function removeFromWishlist(productId,el){

  fetch(`/remove-from-wishlist/${productId}`,{
    method:"DELETE",
  }).then(res=>res.json())
  .then((data)=>{
    if(data.success){
      el.dataset.wish=false;
      el.classList.replace("fa-solid","fa-regular");

      let wishIcon = document.getElementById('wishIcon');      
      let currentCount = parseInt(wishIcon.innerText.trim()) || 0;      
      wishIcon.innerText = Math.max(0, currentCount - 1);

    }else{
      Swal.fire({
        title:"Oops",
        text:"Please try again!",
        icon:"error"
      })
    }
  })
}


</script>


<%- include("../../views/user/partials/footer.ejs") %>


