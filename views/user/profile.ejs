<%- include("../../views/user/partials/header.ejs") %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="/css/user/profile.css" type="text/css">

<main class="container py-5">
  <div class="row justify-content-center">
    <!-- Content -->
    <div class="col-lg-9 all-contents">
      <!-- User Details -->
      <div class="card dashboard-card p-4 mb-4">
        <div class="d-flex justify-content-between">
          <h4>User Profile</h4>
          <% if(newbee===true) {%>
          <a href='#' class="referral-link" data-bs-toggle="modal" data-bs-target="#referralModal">Do you have a referal code?</a>
          <% }else{%>
            <a href="#" class="referral-link" data-bs-toggle="modal" data-bs-target="#referralCodeModal">REFER AND EARN !!!</a>
            <% } %>
        </div>
        <div class="d-flex align-items-center">
          <div class="profile-pic-wrapper position-relative d-inline-block">
  <% if (userData.userImage) { %>
    <img src="/uploads/profiles/<%= userData.userImage %>" class="profile-img">
  <% } else { %>
    <img src="/uploads/profiles/default-avatar.jpg" class="profile-img">
  <% } %>

  <!-- Edit Icon Overlay -->
   <form method="post" action="/change-profile-pic/'<%=userData._id%>'"></form>
  <label for="profileImageInput" class="edit-icon-overlay">
    <i class="bi bi-pencil-fill"></i>
  </label>
  <input type="file" id="profileImageInput" onchange="changeProfilePic('<%=userData._id%>')" class="d-none" accept="image/*">
  </div>
  </form>

          <div>
            <p><strong>Name:</strong> <%= userData.name %></p>
            <p><strong>Email:</strong> <%= userData.email %></p>
            <p><strong>Phone:</strong> <%= userData.phone %></p>
          </div>
        </div>
        <div>
          <button class="btn btn-primary w-100" href="/edit-profile"><a class="btn btn-primary w-100" href="/edit-profile">Edit profile</a></button>
          </div>
      </div>

      <!-- Addresses -->
      <div class="card dashboard-card p-4 mb-4">
        <h4>Saved Addresses</h4>
        <div class="row">
          <% if (address && address.length > 0) { %>
            <% address.forEach(addr => { %>
              <div class="col-lg-6 mb-3">
                <div class="card">
                  <div class="card-body">
                    <h6><%= addr.label %></h6>
                    <p><%= addr.street %>, <%= addr.city %>, <%= addr.state %> - <%= addr.postalCode %></p>
                    <div class="d-flex justify-content-between">
                      <button type="button" class="btn btn-sm btn-link float-end text-decoration-none"data-bs-toggle="modal"
                        data-bs-target="#addAddressModal-1"onclick="populateAddressForm('<%= addr._id %>','<%= addr.label %>', '<%= addr.street %>', '<%= addr.city %>', '<%= addr.state %>', '<%= addr.country %>', '<%= addr.postalCode %>', '<%= addr.phone %>', <%= addr.isDefault %>)">
                        <i class="bi bi-pencil"></i> Edit
                 </button>
                      <a href="/delete-address/<%= addr._id %>" class="btn btn-sm btn-outline-danger">Delete</a>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p>No addresses saved.</p>
          <% } %>
        </div>
        <button class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#addAddressModal"> + Add New Address</button>
        <% if (totalAddPages > 1) { %>
  <nav aria-label="Orders pagination">
    <ul class="pagination pagination-sm justify-content-center mb-0">
      <li class="page-item <%= currentAddPage === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?addPage=<%= currentAddPage - 1 %>">Previous</a>
      </li>
      <% for (let i = 1; i <= totalAddPages; i++) { %>
        <li class="page-item <%= currentAddPage === i ? 'active' : '' %>">
          <a class="page-link" href="?addPage=<%= i %>"><%= i %></a>
        </li>
      <% } %>
      <li class="page-item <%= currentAddPage === totalAddPages ? 'disabled' : '' %>">
        <a class="page-link" href="?addPage=<%= currentAddPage + 1 %>">Next</a>
      </li>
    </ul>
  </nav>
  <% } %>
      </div>

      <!-- Orders -->
      <div class="card dashboard-card p-4 mb-4">
        <h4>My Orders</h4>
        <table class="table table-bordered align-middle">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Status</th>
              <th>Total</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (orders && orders.length > 0) { %>
              <% orders.forEach(order => { %>
                <tr>
                  <td>#<%= order.orderId %></td>
                  <td><%= order.status %></td>
                  <td>₹<%= order.totalAmount %></td>
                  <td><%= order.createdAt.toDateString() %></td>
                  <td>
                    <a href="/orders?id=<%= order.orderId %>" class="btn btn-sm btn-outline-primary">View</a>
                    <%if(order.paymentMethod==="ONLINE"&&order.paymentStatus==="PENDING") {%>
                      <button   class="btn btn-sm btn-outline-danger" id="pay"onclick="retryPayment('<%= order.orderId %>')">Pay now</button>
                    <%}else if (order.status === "Pending" || order.status === "Processing") { %>
                      <button   class="btn btn-sm btn-outline-danger"  onclick="cancelOrder('<%= order.orderId %>')">Cancel</button>
                    <% }else if(order.status === "Delivered" || order.status === "Shipped"){ %>
                    <button   class="btn btn-sm btn-outline-danger"  onclick="returnOrder('<%= order.orderId %>')">Return</button>
                    <% } %>     
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" class="text-center">No orders found.</td></tr>
            <% } %>
          </tbody>
        </table>
          <!-- Pagination -->
  <% if (totalOrderPages > 1) { %>
  <nav aria-label="Orders pagination">
    <ul class="pagination pagination-sm justify-content-center mb-0">
      <li class="page-item <%= currentOrderPage === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?orderPage=<%= currentOrderPage - 1 %>">Previous</a>
      </li>
      <% for (let i = 1; i <= totalOrderPages; i++) { %>
        <li class="page-item <%= currentOrderPage === i ? 'active' : '' %>">
          <a class="page-link" href="?orderPage=<%= i %>"><%= i %></a>
        </li>
      <% } %>
      <li class="page-item <%= currentOrderPage === totalOrderPages ? 'disabled' : '' %>">
        <a class="page-link" href="?orderPage=<%= currentOrderPage + 1 %>">Next</a>
      </li>
    </ul>
  </nav>
  <% } %>
      </div>

     
      <!-- Wallet -->
<div class="card dashboard-card p-4 mb-4 wallet-container">
  <h4>My Wallet</h4>
  <% if(wallet) {%>
  <div class="alert alert-info mb-4">
    <h5 class="mb-0">Available Balance: ₹<%=wallet.balance%></h5>
  </div>
  <% }else{ %>
    <div class="alert alert-info mb-4">
    <h5 class="mb-0">Available Balance: ₹0</h5>
  </div>
 <% } %>

  <h5 class="mb-3">Transaction History</h5>
  <table class="table table-bordered align-middle wallet-table">
    <thead>
      <tr>
        <th>Transaction ID</th>
        <th>Order ID</th>
        <th>Amount</th>
        <th>Type</th>
        <th>Date</th>
      </tr>
    </thead>
    <tbody>
      <% if(transactions) {%>
        <%transactions.forEach((transaction)=>{%>
      <tr>
        <td><%= transaction.transactionId%></td>
        <td><%= transaction.relatedOrderId%></td>
        <% if(transaction.type==="debit") {%>
        <td class="text-danger">₹<%= transaction.amount%></td>
        <td><span class="badge bg-danger"><%= transaction.type%></span></td>
        <% }else{%>
         <td class="text-success">₹<%= transaction.amount%></td> 
        <td><span class="badge bg-success"><%= transaction.type%></span></td>
        <% } %>
        <td><%= new Date(transaction.createdAt).toLocaleDateString() %></td>
      </tr>
      <%})%>
      <% }else{%>
      <tr><td colspan="5" class="text-center">No transactions found.</td></tr>
      <% } %>
    </tbody>
  </table>
  <!-- Pagination -->
  <% if (totalTpages > 1) { %>
  <nav aria-label="Orders pagination">
    <ul class="pagination pagination-sm justify-content-center mb-0">
      <li class="page-item <%= currentTpage == 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?tpage=<%= currentTpage - 1 %>">Previous</a>
      </li>
      <% for (let i = 1; i <= totalTpages; i++) { %>
        <li class="page-item <%= currentTpage === i ? 'active' : '' %>">
          <a class="page-link" href="?tpage=<%= i %>"><%= i %></a>
        </li>
      <% } %>
      <li class="page-item <%= currentTpage == totalTpages ? 'disabled' : '' %>">
        <a class="page-link" href="?tpage=<%= currentTpage + 1 %>">Next</a>
      </li>
    </ul>
  </nav>
  <% } %>
</div>
<!-- Wishlist Section - Add this right after the wallet section -->
<div class="card dashboard-card p-4 mb-4">
  <h4>My Wishlist</h4>
  <div class="row" id="wishlist-container">
    <% if (wishlist && wishlist.length > 0) { %>
      <% wishlist.forEach(item => { %>
        <div class="col-lg-4 col-md-6 mb-3 wishlist-item"id="wishlist-<%=item.product._id%>">
          <div class="card h-100 p-2">
            <img src="/uploads/re-image/<%= item.product.productImage[0] %>" 
                 class="card-img-top" 
                 alt="<%= item.product.productName %>"
                 style="height: 180px; object-fit: cover;">
            <div class="card-body d-flex flex-column">
              <h6 class="card-title mb-2"><%= item.product.productName %></h6>
              <p class="text-danger fw-bold mb-3">
                ₹<%= item.product.salesPrice || item.product.regularPrice %>
              </p>
              <div class="mt-auto d-flex gap-2">
                <a href="/product-details?id=<%= item.product._id %>" class="btn btn-sm btn-outline-primary flex-grow-1">
                  <i class="bi bi-eye"></i> View
                </a>
                <button onclick="removeFromWishlist('<%= item.product._id %>')" class="btn btn-sm btn-outline-danger">
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12 text-center py-4">
        <i class="bi bi-heart" style="font-size: 48px; color: var(--text-muted);"></i>
        <p class="text-muted mt-2">Your wishlist is empty.</p>
        <a href="/shop" class="btn btn-primary mt-2">Browse Products</a>
      </div>
    <% } %>
  </div>
  <% if (totalWpages > 1) { %>
  <nav aria-label="Orders pagination">
    <ul class="pagination pagination-sm justify-content-center mb-0">
      <li class="page-item <%= currentWpage == 1 ? 'disabled' : '' %>">
        <a class="page-link" href="?wpage=<%= currentWpage - 1 %>">Previous</a>
      </li>
      <% for (let i = 1; i <= totalWpages; i++) { %>
        <li class="page-item <%= currentWpage === i ? 'active' : '' %>">
          <a class="page-link" href="?wpage=<%= i %>"><%= i %></a>
        </li>
      <% } %>
      <li class="page-item <%= currentWpage == totalWpages ? 'disabled' : '' %>">
        <a class="page-link" href="?wpage=<%= currentWpage + 1 %>">Next</a>
      </li>
    </ul>
  </nav>
  <% } %>
</div>
    </div>  
  </div>
</main>

