<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email Verification</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <link rel="stylesheet" href="/public/css/user/forgot-password.css" type="text/css">
</head>
<body>

<!-- Header -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3">
  <div class="container">
    <a class="navbar-brand fw-bold" href="#">FIGHT CLUB</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navContent">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="#">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Best Sellers</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Shop</a></li>
        <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
      </ul>
      <div class="ms-4 text-white">
        <span class="me-3">Search</span> | <span class="ms-3">Cart (0)</span>
      </div>
    </div>
  </div>
</nav>

<!-- Main Section -->
<section class="email-section container">
  <div class="w-100" style="max-width: 500px;">
    <h4 class="mb-4 fw-bold">Please enter your email</h4>
    <form id="emailForm" novalidate>
      <div class="form-floating mb-3">
        <input type="email" class="form-control" name="emailId" id="emailInput" placeholder="name@example.com" required>
        <label for="emailInput">Enter your email</label>
        <div class="invalid-feedback">Please enter a valid email address.</div>
      </div>
      <button type="submit" class="btn btn-black w-100">Submit</button>
    </form>
  </div>
</section>

<!-- Footer -->
<footer class="footer text-center">
  <div class="container">
    <div class="row">
      <div class="col-md-4 mb-4">
        <div class="logo-text">FIGHT CLUB</div>
      </div>
      <div class="col-md-4 mb-4">
        <h6>Help</h6>
        <ul>
          <li>Shipping</li>
          <li>Contact Us</li>
          <li>Return & Exchange Policy</li>
          <li>Exchange Request</li>
          <li>Warranty</li>
        </ul>
      </div>
      <div class="col-md-4 mb-4">
        <h6>Menu</h6>
        <ul>
          <li>About Me</li>
          <li>Privacy Policy</li>
          <li>Terms of Service</li>
        </ul>
      </div>
    </div>
    <p class="mt-3 mb-0 text-muted">© 2024 - URBAN AGES</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/user/forgot-password.js"></script>
</body>
</html>
